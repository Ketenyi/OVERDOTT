---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { whatsappNumber } from '../../config';

const whatsappUrl = `https://wa.me/${whatsappNumber}`;

const beliefs = [
  ['Security and Trust Come First', 'Technology must be built and managed responsibly. We value security, privacy and the trust customers place in us.'],
  ['Practicality Over Complexity', 'The best solution is not necessarily the most sophisticated one. We believe in choosing technology that addresses the actual problem and fits the organization’s needs.'],
  ['Integrity in Every Engagement', 'We believe in honest communication, clear expectations and delivering within agreed commitments. Trust is earned through consistency, not promises.'],
  ['Continuous Improvement', 'Technology evolves, and so do business needs. We believe in continuous learning, thoughtful innovation and helping organizations adapt with confidence.'],
  ['Relationships Over Transactions', 'We value lasting working relationships. Understanding our customers, their environments and their goals allows us to deliver solutions that remain relevant beyond initial implementation.'],
];

const steps = [
  ['Understand', 'We take time to understand your business, existing environment, challenges and objectives.'],
  ['Recommend', 'We identify appropriate solutions based on your requirements, priorities and available resources.'],
  ['Deliver', 'We focus on responsible implementation, clear communication, proper documentation and agreed outcomes.'],
  ['Support & Improve', 'We believe technology requires ongoing attention. We help customers maintain, improve and adapt their solutions as their needs evolve.'],
];
---

<BaseLayout
  title="About Overdott Technologies | Practical Technology Solutions"
  description="Learn about Overdott Technologies Limited, our approach to digital solutions, business systems and IT infrastructure, and the principles that guide our work."
>
  <section class="page-hero page-hero-simple about-hero">
    <div class="page-width page-hero-inner">
      <div class="page-hero-copy">
        <p class="eyebrow">About Overdott</p>
        <h1>Technology with purpose.<br /><span class="editorial-accent">Solutions with perspective.</span></h1>
        <p>At Overdott Technologies, we believe technology should make businesses stronger, operations more reliable and opportunities more accessible.</p>
        <p>We help organizations make their technology more useful, secure and dependable through practical digital solutions, IT infrastructure and business systems.</p>
      </div>
    </div>
  </section>

  <section class="section page-width about-opening" aria-labelledby="about-opening-title">
    <div class="about-section-label">
      <p class="eyebrow">Who we are</p>
      <span>01</span>
    </div>
    <div class="about-opening-copy">
      <h2 id="about-opening-title">A technology solutions company focused on the business behind the technology.</h2>
      <p>Overdott Technologies is a technology solutions company focused on helping businesses navigate their technology needs with confidence.</p>
      <p>We bring together expertise across IT infrastructure, systems integration, cloud technologies, cybersecurity and software development to help organizations build and maintain technology environments that support their operations and growth.</p>
      <p>Our approach is grounded in understanding the business behind the technology. Rather than introducing complexity for its own sake, we focus on identifying challenges, recommending appropriate solutions and delivering outcomes that make a meaningful difference.</p>
      <p>Whether supporting an existing IT environment, developing a digital solution or improving business processes, our objective remains the same: making technology practical, dependable and valuable.</p>
      <a class="text-link" href="/services/">Explore our services <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section section-tint about-beliefs" aria-labelledby="about-beliefs-title">
    <div class="page-width about-beliefs-layout">
      <div class="about-section-label">
        <p class="eyebrow">What we believe</p>
        <h2 id="about-beliefs-title">The principles behind our work.</h2>
        <span>02</span>
      </div>
      <ol class="about-belief-list">
        {beliefs.map(([title, description]) => (
          <li>
            <h3>{title}</h3>
            <p>{description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section page-width about-direction" aria-label="Our mission and vision">
    <article>
      <p class="eyebrow">Our mission</p>
      <h2>Practical technology.<br />Dependable outcomes.</h2>
      <p>To deliver practical, secure and dependable technology infrastructure and digital solutions that help organizations operate with confidence, improve efficiency and achieve their business objectives.</p>
    </article>
    <article>
      <p class="eyebrow">Our vision</p>
      <h2>Technology that moves<br />organizations forward.</h2>
      <p>To grow into a trusted technology and systems-integration company across East Africa, recognized for dependable delivery, sound security practices and meaningful digital innovation.</p>
    </article>
  </section>

  <section class="section page-width about-work" aria-labelledby="about-work-title">
    <div class="about-work-heading">
      <div class="about-section-label">
        <p class="eyebrow">How we work</p>
        <span>03</span>
      </div>
      <h2 id="about-work-title">Successful technology engagements begin with understanding, not assumptions.</h2>
    </div>
    <ol class="about-work-list">
      {steps.map(([title, description], index) => (
        <li>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{title}</h3>
          <p>{description}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section section-dark about-commitment">
    <div class="page-width about-commitment-layout">
      <div>
        <p class="eyebrow">Our commitment</p>
        <h2>Technology is important.<br />So is the responsibility that comes with it.</h2>
      </div>
      <div class="about-commitment-copy">
        <p>We understand that technology is an important part of how businesses operate, serve customers and protect their information.</p>
        <p>That responsibility is something we take seriously.</p>
        <p>We are committed to approaching every engagement with professionalism, transparency and a focus on practical outcomes. We remain accountable for the agreed scope, communication and delivery commitments.</p>
        <p>Our goal is not simply to introduce technology, but to help businesses get lasting value from it.</p>
      </div>
    </div>
  </section>

  <section class="section page-width about-looking-ahead" aria-labelledby="about-looking-title">
    <div class="about-section-label">
      <p class="eyebrow">Looking ahead</p>
      <span>04</span>
    </div>
    <div>
      <h2 id="about-looking-title">Building technology that moves businesses forward.</h2>
      <p>We believe the future belongs to organizations that use technology thoughtfully. We are building Overdott around that belief — one solution, one relationship and one meaningful improvement at a time.</p>
      <a class="text-link" href="/solutions/">See how we approach business challenges <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="cta-band">
    <div class="page-width cta-inner">
      <div>
        <p class="eyebrow">Start a conversation</p>
        <h2>Let’s build something that works.</h2>
        <p>Let’s Talk About Your Business.</p>
      </div>
      <div class="cta-actions">
        <a class="button button-light" href="/contact/">Talk to Overdott <span aria-hidden="true">↗</span></a>
        <a class="button button-outline" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Chat on WhatsApp <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero .page-hero-copy {
    max-width: 920px;
  }

  .about-hero h1 {
    max-width: 930px;
  }

  .editorial-accent {
    color: var(--blue-light);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.93em;
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.045em;
  }

  .about-opening,
  .about-beliefs-layout,
  .about-looking-ahead {
    display: grid;
    grid-template-columns: minmax(210px, 0.48fr) minmax(0, 1.52fr);
    gap: clamp(40px, 7vw, 96px);
  }

  .about-section-label {
    position: relative;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .about-section-label > span {
    display: block;
    margin-top: 32px;
    color: #8a96a4;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .about-opening-copy {
    max-width: 780px;
  }

  .about-opening-copy h2 {
    margin-bottom: 24px;
    font-size: clamp(1.75rem, 2.7vw, 2.35rem);
    line-height: 1.3;
  }

  .about-opening-copy p {
    font-size: 16px;
    line-height: 1.8;
  }

  .about-opening-copy .text-link {
    margin-top: 12px;
  }

  .about-beliefs-layout {
    align-items: start;
  }

  .about-beliefs .about-section-label {
    border-color: #d5d8d6;
  }

  .about-beliefs .about-section-label h2 {
    max-width: 300px;
    margin-top: 22px;
    font-size: clamp(1.8rem, 2.8vw, 2.5rem);
  }

  .about-belief-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid #cfd4d2;
    list-style: none;
    counter-reset: beliefs;
  }

  .about-belief-list li {
    display: grid;
    padding: 25px 0;
    border-bottom: 1px solid #cfd4d2;
    grid-template-columns: minmax(220px, 0.8fr) minmax(0, 1.2fr);
    gap: 28px;
    counter-increment: beliefs;
  }

  .about-belief-list h3 {
    margin: 0;
    font-size: 1.12rem;
    line-height: 1.4;
  }

  .about-belief-list h3::before {
    display: block;
    margin-bottom: 10px;
    color: var(--blue);
    content: '0' counter(beliefs);
    font-family: inherit;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .about-belief-list p {
    margin: 0;
    font-size: 14px;
    line-height: 1.75;
  }

  .about-direction {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
  }

  .about-direction article {
    padding-right: clamp(30px, 5vw, 70px);
  }

  .about-direction article + article {
    padding-right: 0;
    padding-left: clamp(30px, 5vw, 70px);
    border-left: 1px solid var(--line);
  }

  .about-direction h2 {
    margin-bottom: 20px;
    font-size: clamp(1.8rem, 2.8vw, 2.5rem);
  }

  .about-direction p {
    max-width: 520px;
    margin-bottom: 0;
    font-size: 15px;
    line-height: 1.8;
  }

  .about-work-heading {
    display: grid;
    margin-bottom: 32px;
    grid-template-columns: minmax(210px, 0.48fr) minmax(0, 1.52fr);
    gap: clamp(40px, 7vw, 96px);
  }

  .about-work-heading h2 {
    max-width: 780px;
    margin-bottom: 0;
    font-size: clamp(1.9rem, 3vw, 2.7rem);
  }

  .about-work-list {
    display: grid;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    grid-template-columns: repeat(4, minmax(0, 1fr));
    list-style: none;
  }

  .about-work-list li {
    padding: 24px 24px 0 0;
  }

  .about-work-list li + li {
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }

  .about-work-list li > span {
    display: block;
    margin-bottom: 28px;
    color: var(--blue);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .about-work-list h3 {
    margin-bottom: 10px;
    font-size: 1.08rem;
  }

  .about-work-list p {
    margin-bottom: 0;
    font-size: 13px;
    line-height: 1.75;
  }

  .about-commitment-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: start;
    gap: clamp(44px, 7vw, 100px);
  }

  .about-commitment h2 {
    max-width: 530px;
    margin-bottom: 0;
    font-size: clamp(2rem, 3.2vw, 2.8rem);
  }

  .about-commitment-copy p {
    font-size: 15px;
    line-height: 1.8;
  }

  .about-commitment-copy p:last-child {
    margin-bottom: 0;
  }

  .about-looking-ahead > div:last-child {
    max-width: 780px;
  }

  .about-looking-ahead h2 {
    margin-bottom: 20px;
    font-size: clamp(1.9rem, 3vw, 2.7rem);
  }

  .about-looking-ahead > div:last-child > p {
    font-size: 16px;
    line-height: 1.8;
  }

  @media (max-width: 940px) {
    .about-work-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 30px 0;
    }

    .about-work-list li:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 760px) {
    .about-opening,
    .about-beliefs-layout,
    .about-looking-ahead,
    .about-work-heading,
    .about-commitment-layout,
    .about-direction {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .about-section-label > span {
      display: none;
    }

    .about-belief-list li {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .about-direction article,
    .about-direction article + article {
      padding: 0;
      border: 0;
    }

    .about-direction article + article {
      padding-top: 30px;
      border-top: 1px solid var(--line);
    }

    .about-work-heading {
      margin-bottom: 26px;
    }
  }

  @media (max-width: 520px) {
    .about-opening-copy p,
    .about-looking-ahead > div:last-child > p {
      font-size: 15px;
    }

    .about-work-list {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .about-work-list li,
    .about-work-list li + li,
    .about-work-list li:nth-child(3) {
      display: grid;
      padding: 20px 0;
      border-top: 1px solid var(--line);
      border-left: 0;
      grid-template-columns: 32px minmax(0, 1fr);
      gap: 4px 12px;
    }

    .about-work-list li:first-child {
      border-top: 0;
    }

    .about-work-list li > span {
      margin: 0;
      padding-top: 4px;
      grid-row: 1 / span 2;
    }

    .about-work-list h3 {
      margin-bottom: 4px;
    }
  }
</style>
