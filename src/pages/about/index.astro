---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechVisual from '../../components/TechVisual.astro';
import { whatsappNumber } from '../../config';

const whatsappUrl = `https://wa.me/${whatsappNumber}`;

const values = [
  ['Practical innovation', 'Choose technology for the problems it can solve, not novelty alone.'],
  ['Security and responsibility', 'Consider security, access and risk as part of implementation.'],
  ['Integrity and transparency', 'Be clear about scope, assumptions, responsibilities and limitations.'],
  ['Customer-focused delivery', 'Keep requirements and the people using the systems in view.'],
  ['Continuous learning', 'Stay curious as tools, risks and business needs evolve.'],
  ['Long-term value', 'Consider maintainability and ownership alongside the initial decision.'],
];
---

<BaseLayout title="About Overdott Technologies | Our Approach and Values" description="Learn about Overdott Technologies Limited's purpose, mission and practical approach to technology solutions in Kenya.">
  <section class="page-hero page-hero-split">
    <div class="page-width page-hero-inner">
      <div class="page-hero-copy">
        <p class="eyebrow">About Overdott</p>
        <h1>Technology should make work clearer, safer and more connected.</h1>
        <p>Overdott Technologies Limited helps organizations explore, implement and manage practical technology solutions.</p>
        <div class="hero-actions">
          <a class="button" href="/contact/">Start a conversation <span aria-hidden="true">↗</span></a>
          <a class="button button-outline" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Chat on WhatsApp <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <aside class="page-hero-aside" aria-label="Our approach">
        <div class="hero-panel">
          <p class="hero-panel-label">How we work</p>
          <div class="hero-panel-list">
            <div class="hero-panel-row">
              <strong>Understand</strong>
              <span>Requirements first</span>
            </div>
            <div class="hero-panel-row">
              <strong>Connect</strong>
              <span>Systems in context</span>
            </div>
            <div class="hero-panel-row">
              <strong>Deliver</strong>
              <span>Clear responsibilities</span>
            </div>
            <div class="hero-panel-row">
              <strong>Consider</strong>
              <span>Long-term value</span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section page-width">
    <div class="image-copy">
      <div class="about-story-copy">
        <p class="eyebrow">Our purpose</p>
        <h2>Practical technology, considered as a whole.</h2>
        <p>Organizations rely on connected infrastructure, secure access, useful software and digital channels. Overdott brings these needs into one conversation, from technology sourcing and integration to digital development and support.</p>
        <p>Our approach is to understand the requirement first, explain options clearly and agree on work that fits the engagement.</p>
      </div>
      <div class="about-visual">
        <TechVisual />
      </div>
    </div>
  </section>

  <section class="section section-compact section-tint">
    <div class="page-width">
      <div class="section-heading">
        <p class="eyebrow">Our direction</p>
        <h2>Useful technology. A long-term view.</h2>
      </div>
      <div class="mission-grid">
        <article class="mission-card">
          <p class="eyebrow">Our mission</p>
          <h3>Help businesses use technology effectively.</h3>
          <p>To help businesses adopt, integrate and use technology effectively through practical solutions, dependable technical services and a commitment to security, usability and long-term value.</p>
        </article>
        <article class="mission-card">
          <p class="eyebrow">Our vision</p>
          <h3>Build trust through useful technology.</h3>
          <p>To become a trusted technology solutions and integration partner for businesses in Kenya and, over time, across Africa.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-compact page-width">
    <div class="section-heading">
      <p class="eyebrow">Our values</p>
      <h2>How we approach the work.</h2>
      <p>These principles guide how we scope recommendations, communicate and consider what happens after implementation.</p>
    </div>
    <div class="values-grid">
      {values.map(([title, description]) => (
        <div class="value-item">
          <h3>{title}</h3>
          <p>{description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="cta-band">
    <div class="page-width cta-inner">
      <div>
        <p class="eyebrow">Start a conversation</p>
        <h2>Start with the outcome you need.</h2>
        <p>Tell us what you are trying to solve, and we'll explore practical next steps.</p>
      </div>
      <div class="cta-actions">
        <a class="button button-light" href="/contact/">Contact Overdott <span aria-hidden="true">↗</span></a>
        <a class="button button-outline" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Chat on WhatsApp <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
