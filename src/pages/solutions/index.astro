---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { coreServices } from '../../data/services';
import { whatsappNumber } from '../../config';

const whatsappUrl = `https://wa.me/${whatsappNumber}`;

const solutionAreas = [
  { label: 'Infrastructure', detail: 'Systems & integration' },
  { label: 'Cybersecurity', detail: 'Protection & digital trust' },
  { label: 'Cloud & IT management', detail: 'Productivity & operations' },
  { label: 'Technology sourcing', detail: 'Hardware, software & licensing' },
];

const serviceMarks: Record<string, string> = {
  infrastructure: 'IT',
  cybersecurity: 'CS',
  'cloud-it-management': 'CL',
  'technology-procurement': 'TP',
};
---

<BaseLayout title="IT Solutions | Infrastructure, Cybersecurity & Cloud | Overdott" description="Explore IT infrastructure, cybersecurity, cloud, IT management and technology sourcing services for organizations in Kenya.">
  <section class="page-hero page-hero-split">
    <div class="page-width page-hero-inner">
      <div class="page-hero-copy">
        <p class="eyebrow">Technology solutions</p>
        <h1>Technology that fits the way your organization works.</h1>
        <p>Explore practical infrastructure, security and IT management, scoped around your requirements, existing environment and next steps.</p>
        <div class="hero-actions">
          <a class="button" href="/contact/">Discuss your requirements <span aria-hidden="true">↗</span></a>
          <a class="button button-outline" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Chat on WhatsApp <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <aside class="page-hero-aside" aria-label="Technology solution areas">
        <div class="hero-panel">
          <p class="hero-panel-label">Four connected areas</p>
          <div class="hero-panel-grid">
            {solutionAreas.map((area) => (
              <div class="hero-panel-item">
                <small>{area.detail}</small>
                <strong>{area.label}</strong>
              </div>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section page-width">
    <div class="section-heading">
      <p class="eyebrow">Explore our capabilities</p>
      <h2>Connected technology. Clear responsibilities.</h2>
      <p>Each engagement starts with a conversation. Availability, deliverables and implementation arrangements are confirmed in scope.</p>
    </div>
    <div class="card-grid">
      {coreServices.map((service, index) => (
        <article class="service-card">
          <div class="service-card-top">
            <span class="service-card-mark" aria-hidden="true">{serviceMarks[service.slug]}</span>
            <span class="service-index">0{index + 1} / SOLUTION</span>
          </div>
          <h3>{service.title}</h3>
          <p>{service.summary}</p>
          <a class="text-link" href={`/services/${service.slug}/`}>Explore this solution <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-compact section-tint">
    <div class="page-width">
      <div class="section-heading">
        <p class="eyebrow">A coordinated engagement</p>
        <h2>From requirements to implementation.</h2>
      </div>
      <div class="process-grid">
        <div class="process-step">
          <h3>Understand</h3>
          <p>Clarify objectives, environment, constraints and stakeholders.</p>
        </div>
        <div class="process-step">
          <h3>Design</h3>
          <p>Compare options, dependencies and implementation scope.</p>
        </div>
        <div class="process-step">
          <h3>Implement</h3>
          <p>Coordinate agreed sourcing, configuration, integration and testing.</p>
        </div>
        <div class="process-step">
          <h3>Support</h3>
          <p>Document handover and discuss support where required.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="page-width cta-inner">
      <div>
        <p class="eyebrow">Start a conversation</p>
        <h2>Have a technology requirement to work through?</h2>
        <p>Share the outcome you need and we'll identify a practical next step.</p>
      </div>
      <div class="cta-actions">
        <a class="button button-light" href="/contact/">Request a consultation <span aria-hidden="true">↗</span></a>
        <a class="button button-outline" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Chat on WhatsApp <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
