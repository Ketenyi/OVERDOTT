---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { whatsappNumber } from '../../config';

const whatsappUrl = `https://wa.me/${whatsappNumber}`;

const scenarios = [
  {
    id: 'digital-presence',
    number: '01',
    title: 'Digital Business Presence',
    challenge: 'Your business needs a professional online presence that communicates what you offer and helps customers connect with you.',
    approach: 'Design and develop a responsive business website with clear service information, contact options and relevant functionality.',
    deliverables: ['Corporate website', 'Service and product pages', 'Contact and enquiry forms', 'Mobile-responsive layouts', 'Website analytics integration where appropriate'],
    interest: 'digital-development',
    cta: 'Discuss a Digital Project',
  },
  {
    id: 'process-digitization',
    number: '02',
    title: 'Business Process Digitization',
    challenge: 'Your team depends on emails, spreadsheets and paperwork to complete routine business processes.',
    approach: 'Digitize relevant workflows using web applications, structured forms, approvals and automated notifications.',
    deliverables: ['Digital forms', 'Approval workflows', 'Process tracking', 'Reporting', 'Notifications'],
    interest: 'business-automation',
    cta: 'Discuss Your Business Process',
  },
  {
    id: 'inventory-management',
    number: '03',
    title: 'Inventory & Operational Management',
    challenge: 'Your business struggles with stock visibility, manual records or disconnected operational information.',
    approach: 'Develop or implement an appropriate system to improve stock records, transactions and reporting.',
    deliverables: ['Inventory records', 'Stock movement tracking', 'Reporting dashboards', 'User access controls', 'Notifications where appropriate'],
    interest: 'business-automation',
    cta: 'Discuss an Automation Project',
  },
  {
    id: 'custom-applications',
    number: '04',
    title: 'Business Application Development',
    challenge: 'Available software does not adequately address your business requirements.',
    approach: 'Develop a purpose-built web application based on defined business requirements.',
    deliverables: ['Requirements analysis', 'Application design', 'Development', 'Testing', 'Deployment', 'Ongoing maintenance'],
    interest: 'business-automation',
    cta: 'Discuss a Custom Application',
  },
  {
    id: 'infrastructure-reliability',
    number: '05',
    title: 'IT Infrastructure Reliability',
    challenge: 'Your business depends on technology infrastructure that requires better visibility, maintenance and technical management.',
    approach: 'Assess the environment and provide appropriate infrastructure configuration, optimization and support.',
    deliverables: ['Infrastructure assessment', 'Server administration', 'Virtualization support', 'Backup configuration', 'Technical maintenance'],
    interest: 'it-infrastructure',
    cta: 'Discuss Your IT Environment',
  },
];
---

<BaseLayout
  title="Business Technology Solutions | Overdott Technologies"
  description="Explore practical Overdott solutions for digital presence, process digitization, inventory, custom business applications and IT infrastructure reliability."
>
  <section class="page-hero page-hero-split">
    <div class="page-width page-hero-inner">
      <div class="page-hero-copy">
        <p class="eyebrow">Solutions</p>
        <h1>Solving everyday business challenges through technology.</h1>
        <p>Technology becomes valuable when it addresses a real problem. We focus on understanding how businesses operate and developing solutions that improve their processes.</p>
        <div class="hero-actions">
          <a class="button" href="/contact/">Discuss Your Requirements <span aria-hidden="true">↗</span></a>
          <a class="button button-outline" href="/services/">Explore our services <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <aside class="page-hero-aside" aria-label="Common solution scenarios">
        <div class="hero-panel">
          <p class="hero-panel-label">Five common scenarios</p>
          <div class="hero-panel-list">
            {scenarios.map((scenario) => (
              <a class="hero-panel-row" href={`#${scenario.id}`}>
                <strong>{scenario.number} / {scenario.title}</strong>
                <span aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section page-width">
    <div class="section-heading">
      <p class="eyebrow">Start with the challenge</p>
      <h2>Practical responses to familiar business problems.</h2>
      <p>These scenarios are starting points for a conversation, not fixed products. The appropriate solution depends on your process, environment, constraints and desired outcome.</p>
    </div>
    <div class="solution-grid">
      {scenarios.map((scenario) => (
        <article class="solution-card" id={scenario.id}>
          <div class="solution-card-heading">
            <span>{scenario.number}</span>
            <h3>{scenario.title}</h3>
          </div>
          <div class="solution-card-copy">
            <div>
              <h4>The challenge</h4>
              <p>{scenario.challenge}</p>
            </div>
            <div>
              <h4>Our approach</h4>
              <p>{scenario.approach}</p>
            </div>
          </div>
          <div class="solution-deliverables">
            <h4>Potential deliverables</h4>
            <ul class="check-list">
              {scenario.deliverables.map((deliverable) => <li>{deliverable}</li>)}
            </ul>
          </div>
          <a class="text-link" href={`/contact/?interest=${scenario.interest}`}>{scenario.cta} <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-dark">
    <div class="page-width solution-principle">
      <div>
        <p class="eyebrow">The right solution, not more technology</p>
        <h2>Every business challenge deserves the right solution.</h2>
      </div>
      <div>
        <p>We help identify what should be custom-built, what may already have a suitable product and what should remain a future initiative. That distinction keeps investment practical.</p>
        <a class="text-link web-text-link" href="/about/">How we approach the work <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="page-width cta-inner">
      <div>
        <p class="eyebrow">Start a conversation</p>
        <h2>Have a business challenge we can help solve?</h2>
        <p>Let’s explore how the right technology can make your business work better.</p>
      </div>
      <div class="cta-actions">
        <a class="button button-light" href="/contact/">Discuss Your Requirements <span aria-hidden="true">↗</span></a>
        <a class="button button-outline" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Chat on WhatsApp <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
