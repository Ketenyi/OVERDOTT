---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { coreServices } from '../../data/services';
---
<BaseLayout title="IT Solutions | Infrastructure, Cybersecurity & Cloud | Overdott" description="Explore IT infrastructure, cybersecurity, cloud, IT management and technology sourcing services for organizations in Kenya.">
  <section class="page-hero"><div class="page-width page-hero-inner"><p class="eyebrow">Technology solutions</p><h1>Technology that fits the way your organization works.</h1><p>Explore practical infrastructure, security and IT management, scoped around your requirements, existing environment and next steps.</p></div></section>
  <section class="section page-width"><div class="section-heading"><p class="eyebrow">Explore our capabilities</p><h2>Connected technology. Clear responsibilities.</h2><p>Each engagement starts with a conversation. Availability, deliverables and implementation arrangements are confirmed in scope.</p></div><div class="card-grid">{coreServices.map((service,index)=><article class="service-card"><span class="service-index">0{index+1} / SOLUTION</span><h3>{service.title}</h3><p>{service.summary}</p><a class="text-link" href={`/services/${service.slug}/`}>Explore this solution <span aria-hidden="true">→</span></a></article>)}</div></section>
  <section class="section section-tint"><div class="page-width"><div class="section-heading"><p class="eyebrow">A coordinated engagement</p><h2>From requirements to implementation.</h2></div><div class="process-grid"><div class="process-step"><h3>Understand</h3><p>Clarify objectives, environment, constraints and stakeholders.</p></div><div class="process-step"><h3>Design</h3><p>Compare options, dependencies and implementation scope.</p></div><div class="process-step"><h3>Implement</h3><p>Coordinate agreed sourcing, configuration, integration and testing.</p></div><div class="process-step"><h3>Support</h3><p>Document handover and discuss support where required.</p></div></div></div></section>
  <section class="cta-band"><div class="page-width cta-inner"><div><h2>Have a technology requirement to work through?</h2><p>Share the outcome you need and we'll identify a practical next step.</p></div><div class="cta-actions"><a class="button button-light" href="/contact/">Request a consultation <span aria-hidden="true">↗</span></a></div></div></section>
</BaseLayout>