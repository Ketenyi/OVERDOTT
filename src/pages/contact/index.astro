---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { contactEmail, whatsappNumber } from '../../config';
---
<BaseLayout title="Contact Overdott | Request a Technology Consultation" description="Tell Overdott about your technology requirements, product enquiry or digital project.">
  <section class="page-hero"><div class="page-width page-hero-inner"><p class="eyebrow">Contact Overdott</p><h1>Let's talk about what your organization needs.</h1><p>Share your goals, a challenge or a product enquiry. We will use your preferred contact method to respond.</p></div></section>
  <section class="section page-width contact-layout"><div><div class="section-heading"><p class="eyebrow">Send an enquiry</p><h2>Tell us a little about your project.</h2><p>Fields marked required help us understand your request. Please do not include passwords or sensitive personal information.</p></div>
    <form class="contact-form" name="consultation" method="POST" action="/contact/success/" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="consultation" /><div class="honeypot" aria-hidden="true"><label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></div>
      <div class="field"><label for="name">Name *</label><input id="name" name="name" autocomplete="name" required /></div><div class="field"><label for="organization">Business or organization</label><input id="organization" name="organization" autocomplete="organization" /></div>
      <div class="field"><label for="email">Contact email *</label><input id="email" type="email" name="email" autocomplete="email" required /></div><div class="field"><label for="phone">Phone number</label><input id="phone" type="tel" name="phone" autocomplete="tel" /></div>
      <div class="field field-full"><label for="service">Service of interest *</label><select id="service" name="service" required><option value="" disabled selected>Select a service</option><option>IT infrastructure and systems integration</option><option>Cybersecurity and digital trust</option><option>Cloud, productivity and IT management</option><option>Technology procurement</option><option>Software and business applications</option><option>Website development</option><option>Digital marketing</option><option>Product enquiry</option><option>Other enquiry</option></select></div>
      <div class="field field-full"><label for="description">How can we help? *</label><textarea id="description" name="description" required minlength="10" maxlength="5000" placeholder="What would you like to achieve? Include useful context, timelines or current systems."></textarea><p class="field-help">Please do not include passwords or confidential information.</p></div>
      <div class="field field-full"><label for="preferred-contact">Preferred contact method *</label><select id="preferred-contact" name="preferred-contact" required><option value="" disabled selected>Choose a contact method</option><option>Email</option><option>Phone</option><option>WhatsApp</option></select></div>
      <div class="field field-full"><label class="consent-row"><input type="checkbox" name="privacy-consent" value="yes" required /><span>I have read the <a href="/privacy/">privacy notice</a> and agree that Overdott may use these details to respond to my enquiry. *</span></label></div>
      <div class="field field-full"><button class="button" type="submit">Send enquiry <span aria-hidden="true">→</span></button></div>
    </form></div>
    <aside class="contact-aside"><p class="eyebrow">Other ways to reach us</p><h2>Choose what works for you.</h2><p>Use the enquiry form for consultation requests, project questions and product enquiries.</p><h3>Email</h3>{contactEmail?<p><a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>:<p class="placeholder-contact">[Business email to be configured before launch]</p>}<h3>WhatsApp</h3>{whatsappNumber?<p><a href={`https://wa.me/${whatsappNumber}`} rel="noopener noreferrer">Start a WhatsApp conversation</a></p>:<p class="placeholder-contact">[WhatsApp number to be configured before launch]</p>}<h3>Location</h3><p>Serving organizations in Kenya. Contact details and service arrangements are confirmed during an enquiry.</p></aside>
  </section>
</BaseLayout>