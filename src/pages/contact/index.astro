---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { contactEmail, whatsappDisplay, whatsappNumber } from '../../config';

const formAction = import.meta.env.PUBLIC_FORM_ACTION?.trim() || '/api/enquiry.php';
const useNetlify = formAction === '/contact/success/';
const resolveAppUrl = (value: string | undefined) => {
  const trimmed = value?.trim();
  if (!trimmed) return null;

  try {
    const url = new URL(trimmed);
    return ['http:', 'https:'].includes(url.protocol) ? url : null;
  } catch {
    return null;
  }
};
const velldotAppUrl =
  resolveAppUrl(import.meta.env.PUBLIC_VELLDOT_URL) ??
  resolveAppUrl(import.meta.env.PUBLIC_SORA_URL);
const velldotSignupUrl = velldotAppUrl
  ? new URL('/signup', velldotAppUrl).toString()
  : '';
---

<BaseLayout title="Contact Overdott | Discuss Your Technology Project" description="Contact Overdott Technologies about website development, business automation, custom applications, IT infrastructure or Velldot products.">
  <section class="page-hero page-hero-split">
    <div class="page-width page-hero-inner">
      <div class="page-hero-copy">
        <p class="eyebrow">Contact Overdott</p>
        <h1>Let's talk about your next technology project.</h1>
        <p>Whether you're planning a new website, looking to automate a business process, developing a custom application or improving your IT infrastructure, we'd be happy to understand what you need.</p>
      </div>
      <aside class="page-hero-aside" aria-label="Direct contact options">
        <div class="hero-panel">
          <p class="hero-panel-label">Prefer a direct conversation?</p>
          <div class="hero-panel-list">
            <div class="hero-panel-row">
              <strong>WhatsApp</strong>
              <a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer">{whatsappDisplay} <span aria-hidden="true">↗</span></a>
            </div>
            <div class="hero-panel-row">
              <strong>Email</strong>
              <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
            </div>
            <div class="hero-panel-row">
              <strong>Based in</strong>
              <span>Kenya</span>
            </div>
          </div>
          <a class="button button-small button-light hero-panel-action" href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer">Chat on WhatsApp <span aria-hidden="true">↗</span></a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section page-width contact-layout" id="enquiry">
    <div>
      <div class="section-heading">
        <p class="eyebrow">Send an enquiry</p>
        <h2>Tell us a little about your project.</h2>
        <p>Share the outcome you want to achieve. Fields marked required help us understand and respond to your request.</p>
      </div>

      <div class="note-box form-error" id="form-error" role="alert" tabindex="-1" hidden>
        <p><strong>Your enquiry could not be sent.</strong> Please try again, email us directly or contact us on WhatsApp.</p>
      </div>

      <form class="contact-form" id="enquiry-form" name="consultation" method="POST" action={formAction} data-netlify={useNetlify ? 'true' : undefined} netlify-honeypot={useNetlify ? 'bot-field' : undefined}>
        <input type="hidden" name="form-name" value="consultation" />
        <input type="hidden" name="interest" value="general" />
        <div class="honeypot" aria-hidden="true">
          <label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="field">
          <label for="name">Full name *</label>
          <input id="name" name="name" autocomplete="name" maxlength="120" required />
        </div>
        <div class="field">
          <label for="email">Business email *</label>
          <input id="email" type="email" name="email" autocomplete="email" maxlength="180" required />
        </div>
        <div class="field">
          <label for="organization">Company name</label>
          <input id="organization" name="organization" autocomplete="organization" maxlength="180" />
        </div>
        <div class="field">
          <label for="phone">Phone number</label>
          <input id="phone" type="tel" name="phone" autocomplete="tel" maxlength="60" />
        </div>

        <div class="field field-full">
          <label for="service">Service of interest *</label>
          <select id="service" name="service" required>
            <option value="" disabled selected>Select a service</option>
            <option>Website &amp; Digital Development</option>
            <option>Business Systems &amp; Automation</option>
            <option>IT Infrastructure &amp; Technical Services</option>
            <option>Velldot Products</option>
            <option>General Enquiry</option>
          </select>
        </div>

        <div class="field field-full">
          <label for="description">Project or enquiry details *</label>
          <textarea id="description" name="description" required minlength="10" maxlength="5000" placeholder="What would you like to achieve? Include useful context, timelines, current systems or product requirements."></textarea>
          <p class="field-help">Please do not include passwords, payment details or confidential information.</p>
        </div>

        <div class="field field-full">
          <label class="consent-row">
            <input type="checkbox" name="privacy-consent" value="yes" required />
            <span>I have read the <a href="/privacy/">privacy notice</a> and agree that Overdott may use these details to respond to my enquiry. *</span>
          </label>
        </div>

        <div class="field field-full form-submit-row">
          <button class="button" type="submit" data-submit-button>
            <span data-submit-label>Send Enquiry</span> <span aria-hidden="true">→</span>
          </button>
          <p class="form-status" data-form-status role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>

    <aside class="contact-aside">
      <p class="eyebrow">Other ways to reach us</p>
      <h2>Choose what works for you.</h2>
      <p>Use the enquiry form for project discussions, service requirements and product questions.</p>

      <div class="contact-product">
        <img src="/velldot-mark.svg" alt="" width="34" height="34" />
        <div>
          <h3>Interested in Velldot?</h3>
          <p>Review verified ERP capabilities, product development status and deployment requirements.</p>
          <a class="text-link" href="/velldot/">Explore Velldot <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <h3>Email</h3>
      {contactEmail ? <p><a href={`mailto:${contactEmail}`}>{contactEmail}</a></p> : <p class="placeholder-contact">[Business email to be configured before launch]</p>}
      <h3>WhatsApp</h3>
      {whatsappNumber ? (
        <p><a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer">{whatsappDisplay}</a></p>
      ) : (
        <p class="placeholder-contact">[WhatsApp number to be configured before launch]</p>
      )}
      <h3>Location</h3>
      <p>Serving organizations in Kenya. Contact details and service arrangements are confirmed during an enquiry.</p>
      {velldotSignupUrl && <p><a class="text-link" href={velldotSignupUrl} target="_blank" rel="noopener noreferrer">Open Velldot signup <span aria-hidden="true">↗</span></a></p>}
    </aside>
  </section>
</BaseLayout>

<script>
  const serviceByInterest: Record<string, string> = {
    'digital-development': 'Website & Digital Development',
    'website-development': 'Website & Digital Development',
    'digital-marketing': 'Website & Digital Development',
    'business-automation': 'Business Systems & Automation',
    'software-development': 'Business Systems & Automation',
    'it-infrastructure': 'IT Infrastructure & Technical Services',
    'infrastructure': 'IT Infrastructure & Technical Services',
    'cybersecurity': 'IT Infrastructure & Technical Services',
    'cloud-it-management': 'IT Infrastructure & Technical Services',
    'technology-procurement': 'IT Infrastructure & Technical Services',
    'velldot': 'Velldot Products',
    'velldot-early-access': 'Velldot Products',
    'velldot-deployment': 'Velldot Products',
    'velldot-documentation': 'Velldot Products',
    'velldot-contact': 'Velldot Products',
    'velldot-trial': 'Velldot Products',
    'velldot-purchase': 'Velldot Products',
    'velldot-sales': 'Velldot Products',
    'general': 'General Enquiry',
  };
  const params = new URLSearchParams(window.location.search);
  const interest = params.get('interest');
  const service = document.querySelector<HTMLSelectElement>('#service');
  const interestField = document.querySelector<HTMLInputElement>('input[name="interest"]');

  if (interest && serviceByInterest[interest]) {
    if (service) service.value = serviceByInterest[interest];
    if (interestField) interestField.value = interest;
  }

  const form = document.querySelector<HTMLFormElement>('#enquiry-form');
  const submitButton = document.querySelector<HTMLButtonElement>('[data-submit-button]');
  const submitLabel = document.querySelector<HTMLElement>('[data-submit-label]');
  const formStatus = document.querySelector<HTMLElement>('[data-form-status]');
  const formError = document.querySelector<HTMLElement>('#form-error');
  const useNetlify = form?.dataset.netlify === 'true';

  const setSubmitting = (submitting: boolean) => {
    if (submitButton) submitButton.disabled = submitting;
    if (submitLabel) submitLabel.textContent = submitting ? 'Sending…' : 'Send Enquiry';
    if (formStatus) formStatus.textContent = submitting ? 'Sending your enquiry…' : '';
    form?.setAttribute('aria-busy', String(submitting));
  };

  if (params.get('status') === 'error') {
    formError?.removeAttribute('hidden');
  }

  form?.addEventListener('submit', (event) => {
    formError?.setAttribute('hidden', '');
    if (!form.reportValidity()) return;

    setSubmitting(true);
    if (useNetlify || !form.action) return;

    event.preventDefault();
    fetch(form.action, {
      method: 'POST',
      body: new FormData(form),
      headers: { Accept: 'text/html' },
      redirect: 'follow',
    })
      .then((response) => {
        const destination = new URL(response.url, window.location.origin);
        if (!response.ok || destination.pathname !== '/contact/success/') {
          throw new Error('Enquiry submission failed');
        }
        window.location.assign(destination.toString());
      })
      .catch(() => {
        setSubmitting(false);
        formError?.removeAttribute('hidden');
        formError?.focus();
      });
  });
</script>

<style>
  .form-error {
    margin-bottom: 24px;
    border-left-color: #b45309;
    background: #fff7ed;
  }

  .form-error[hidden] {
    display: none;
  }

  .form-error p {
    margin-bottom: 0;
    color: #7c4a13;
  }

  .form-submit-row {
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 16px;
  }

  .form-submit-row .button {
    min-width: 168px;
  }

  .form-submit-row .button:disabled {
    cursor: wait;
    opacity: 0.72;
    transform: none;
  }

  .form-status {
    margin: 0;
    color: var(--body);
    font-size: 12px;
  }

  .contact-product {
    display: flex;
    margin-top: 26px;
    padding: 20px;
    border: 1px solid #d9e5f5;
    border-radius: 12px;
    align-items: flex-start;
    gap: 13px;
    background: #fff;
  }

  .contact-product img {
    flex: 0 0 auto;
  }

  .contact-product h3 {
    margin-bottom: 7px;
    font-size: 1rem;
  }

  .contact-product p {
    margin-bottom: 12px;
    font-size: 13px;
  }

  .contact-product .text-link {
    font-size: 13px;
  }

  @media (max-width: 600px) {
    .form-submit-row {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .form-submit-row .button {
      width: 100%;
    }
  }
</style>
