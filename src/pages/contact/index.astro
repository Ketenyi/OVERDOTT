---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { contactEmail, whatsappNumber } from '../../config';

const formAction = import.meta.env.PUBLIC_FORM_ACTION?.trim() || '/api/enquiry.php';
const useNetlify = formAction === '/contact/success/';
const resolveAppUrl = (value: string | undefined) => {
  const trimmed = value?.trim();
  if (!trimmed) return null;

  try {
    const url = new URL(trimmed);
    return ['http:', 'https:'].includes(url.protocol) ? url : null;
  } catch {
    return null;
  }
};
const velldotAppUrl =
  resolveAppUrl(import.meta.env.PUBLIC_VELLDOT_URL) ??
  resolveAppUrl(import.meta.env.PUBLIC_SORA_URL);
const velldotSignupUrl = velldotAppUrl
  ? new URL('/signup', velldotAppUrl).toString()
  : '';
---

<BaseLayout title="Contact Overdott | Software, Cybersecurity & IT" description="Tell Overdott about your software project, cybersecurity requirement, technology product or Velldot ERP trial.">
  <section class="page-hero">
    <div class="page-width page-hero-inner">
      <p class="eyebrow">Contact Overdott</p>
      <h1>Let’s talk about what your organization needs.</h1>
      <p>Share a goal, a challenge or a product requirement. We’ll use your preferred contact method to respond.</p>
    </div>
  </section>

  <section class="section page-width contact-layout" id="enquiry">
    <div>
      <div class="section-heading">
        <p class="eyebrow">Send an enquiry</p>
        <h2>Tell us a little about your project.</h2>
        <p>Fields marked required help us understand your request. Please do not include passwords, payment details or sensitive personal information.</p>
      </div>

      <div class="note-box form-error" id="form-error" role="alert" hidden>
        <p><strong>Your enquiry could not be sent.</strong> Please check the required fields and try again, or email us directly.</p>
      </div>

      <form class="contact-form" id="enquiry-form" name="consultation" method="POST" action={formAction} data-netlify={useNetlify ? 'true' : undefined} netlify-honeypot={useNetlify ? 'bot-field' : undefined}>
        <input type="hidden" name="form-name" value="consultation" />
        <input type="hidden" name="interest" value="general" />
        <div class="honeypot" aria-hidden="true">
          <label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="field">
          <label for="name">Name *</label>
          <input id="name" name="name" autocomplete="name" maxlength="120" required />
        </div>
        <div class="field">
          <label for="organization">Business or organization</label>
          <input id="organization" name="organization" autocomplete="organization" maxlength="180" />
        </div>
        <div class="field">
          <label for="email">Contact email *</label>
          <input id="email" type="email" name="email" autocomplete="email" maxlength="180" required />
        </div>
        <div class="field">
          <label for="phone">Phone number</label>
          <input id="phone" type="tel" name="phone" autocomplete="tel" maxlength="60" />
        </div>

        <div class="field field-full">
          <label for="service">Service of interest *</label>
          <select id="service" name="service" required>
            <option value="" disabled selected>Select a service</option>
            <option>Velldot ERP trial</option>
            <option>Velldot ERP purchase</option>
            <option>Velldot ERP sales consultation</option>
            <option>Velldot ERP documentation</option>
            <option>Velldot ERP support</option>
            <option>Software and business applications</option>
            <option>Cybersecurity and digital trust</option>
            <option>IT infrastructure and systems integration</option>
            <option>Cloud, productivity and IT management</option>
            <option>Technology procurement</option>
            <option>Website development</option>
            <option>Digital marketing</option>
            <option>Other enquiry</option>
          </select>
        </div>

        <div class="field field-full">
          <label for="description">How can we help? *</label>
          <textarea id="description" name="description" required minlength="10" maxlength="5000" placeholder="What would you like to achieve? Include useful context, timelines, team size or current systems."></textarea>
          <p class="field-help">Please do not include passwords, payment details or confidential information.</p>
        </div>

        <div class="field field-full">
          <label for="preferred-contact">Preferred contact method *</label>
          <select id="preferred-contact" name="preferred-contact" required>
            <option value="" disabled selected>Choose a contact method</option>
            <option>Email</option>
            <option>Phone</option>
            <option>WhatsApp</option>
          </select>
        </div>

        <div class="field field-full">
          <label class="consent-row">
            <input type="checkbox" name="privacy-consent" value="yes" required />
            <span>I have read the <a href="/privacy/">privacy notice</a> and agree that Overdott may use these details to respond to my enquiry. *</span>
          </label>
        </div>

        <div class="field field-full">
          <button class="button" type="submit">Send enquiry <span aria-hidden="true">→</span></button>
        </div>
      </form>
    </div>

    <aside class="contact-aside">
      <p class="eyebrow">Other ways to reach us</p>
      <h2>Choose what works for you.</h2>
      <p>Use the enquiry form for consultation requests, project questions, product trials and purchase enquiries.</p>

      <div class="contact-product">
        <img src="/velldot-mark.svg" alt="" width="34" height="34" />
        <div>
          <h3>Interested in Velldot ERP?</h3>
          <p>Explore the modules, trial options and purchase paths on the product page.</p>
          <a class="text-link" href="/velldot/">Explore Velldot <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <h3>Email</h3>
      {contactEmail ? <p><a href={`mailto:${contactEmail}`}>{contactEmail}</a></p> : <p class="placeholder-contact">[Business email to be configured before launch]</p>}
      <h3>WhatsApp</h3>
      {whatsappNumber ? <p><a href={`https://wa.me/${whatsappNumber}`} rel="noopener noreferrer">Start a WhatsApp conversation</a></p> : <p class="placeholder-contact">[WhatsApp number to be configured before launch]</p>}
      <h3>Location</h3>
      <p>Serving organizations in Kenya. Contact details and service arrangements are confirmed during an enquiry.</p>
      {velldotSignupUrl && <p><a class="text-link" href={velldotSignupUrl} rel="noopener noreferrer">Open Velldot signup <span aria-hidden="true">↗</span></a></p>}
    </aside>
  </section>
</BaseLayout>

<script>
  const serviceByInterest: Record<string, string> = {
    'velldot-trial': 'Velldot ERP trial',
    'velldot-purchase': 'Velldot ERP purchase',
    'velldot-sales': 'Velldot ERP sales consultation',
    'velldot-documentation': 'Velldot ERP documentation',
    'velldot-contact': 'Velldot ERP support',
  };
  const params = new URLSearchParams(window.location.search);
  const interest = params.get('interest');
  const service = document.querySelector<HTMLSelectElement>('#service');
  const interestField = document.querySelector<HTMLInputElement>('input[name="interest"]');

  if (interest && serviceByInterest[interest]) {
    if (service) service.value = serviceByInterest[interest];
    if (interestField) interestField.value = interest;
  }

  if (params.get('status') === 'error') {
    document.querySelector('#form-error')?.removeAttribute('hidden');
  }
</script>

<style>
  .form-error {
    margin-bottom: 24px;
    border-left-color: #b45309;
    background: #fff7ed;
  }

  .form-error[hidden] {
    display: none;
  }

  .form-error p {
    margin-bottom: 0;
    color: #7c4a13;
  }

  .contact-product {
    display: flex;
    margin-top: 26px;
    padding: 20px;
    border: 1px solid #d9e5f5;
    border-radius: 12px;
    align-items: flex-start;
    gap: 13px;
    background: #fff;
  }

  .contact-product img {
    flex: 0 0 auto;
  }

  .contact-product h3 {
    margin-bottom: 7px;
    font-size: 1rem;
  }

  .contact-product p {
    margin-bottom: 12px;
    font-size: 13px;
  }

  .contact-product .text-link {
    font-size: 13px;
  }
</style>
