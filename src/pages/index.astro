---
import BaseLayout from '../layouts/BaseLayout.astro';
import { coreServices, digitalServices } from '../data/services';
import { insights } from '../data/insights';
---
<BaseLayout title="Overdott Technologies | Integrated IT & Digital Solutions in Kenya" description="Overdott helps businesses in Kenya source, integrate and manage IT infrastructure, cybersecurity, cloud services, business software and digital experiences.">
  <section class="hero"><div class="hero-inner page-width"><div class="hero-copy"><p class="eyebrow">Technology solutions and systems integration · Kenya</p><h1>Technology that works together. <span>Security that works for you.</span></h1><p>Overdott Technologies Limited helps businesses source, integrate, secure and manage technology, from IT infrastructure and cybersecurity to cloud services, business software and digital experiences.</p><div class="hero-actions"><a class="button" href="/solutions/">Explore our solutions <span aria-hidden="true">→</span></a><a class="button button-outline" href="/contact/">Discuss your project <span aria-hidden="true">↗</span></a></div><div class="hero-proof">Technology sourcing · Integration · Digital development · Support</div></div></div></section>
  <section class="section page-width"><div class="image-copy"><div><p class="eyebrow">A coordinated approach</p><h2>Technology decisions should solve business problems.</h2><p>When systems are bought, configured and managed in isolation, gaps can appear between them. We bring technology sourcing, implementation, integration and digital development into a coordinated conversation.</p><p>Start with the outcome you need. Together, we can clarify requirements, consider practical options and agree on a scope that fits your organization.</p><a class="text-link" href="/about/">Get to know Overdott <span aria-hidden="true">→</span></a></div><img src="https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=1200&q=85" alt="Printed circuit board with connected electronic components" loading="lazy" width="1200" height="900" /></div></section>
  <section class="section section-tint"><div class="page-width"><div class="section-topline"><div class="section-heading"><p class="eyebrow">Technology solutions</p><h2>Build a stronger foundation for the work you do.</h2><p>Explore infrastructure, security and IT services scoped around your environment and priorities.</p></div><a class="text-link" href="/solutions/">All solutions <span aria-hidden="true">→</span></a></div><div class="card-grid">{coreServices.slice(0,3).map((service,index)=><article class="service-card"><span class="service-index">0{index+1} / SOLUTION</span><h3>{service.title}</h3><p>{service.summary}</p><a class="text-link" href={`/services/${service.slug}/`}>Explore this solution <span aria-hidden="true">→</span></a></article>)}</div></div></section>
  <section class="section page-width"><div class="section-heading"><p class="eyebrow">Digital services</p><h2>Useful digital experiences, built with the bigger picture in mind.</h2><p>Websites, software and digital visibility can complement your technology environment and help customers engage with your business.</p></div><div class="card-grid">{digitalServices.map((service,index)=><article class="service-card"><span class="service-index">0{index+1} / DIGITAL</span><h3>{service.title}</h3><p>{service.summary}</p><a class="text-link" href={`/services/${service.slug}/`}>Explore this service <span aria-hidden="true">→</span></a></article>)}</div><p style="margin-top:22px"><a class="text-link" href="/digital-services/">See all digital services <span aria-hidden="true">→</span></a></p></section>
  <section class="section section-dark"><div class="page-width image-copy"><div><p class="eyebrow">Why Overdott</p><h2>Good technology starts with a clear conversation.</h2><p>Recommendations should make sense for your organization, your existing systems and the people who depend on them.</p><ul class="check-list"><li>Business-focused recommendations and clear project scope</li><li>Integrated solutions rather than isolated products</li><li>Security-conscious implementation and handover</li><li>Practical, budget-aware options</li><li>Support according to the agreed engagement</li></ul><a class="button button-light" href="/contact/">Talk through your requirements <span aria-hidden="true">↗</span></a></div><img src="https://images.unsplash.com/photo-1535223289827-42f1e9919769?auto=format&fit=crop&w=1200&q=85" alt="Connected digital network representing integrated technology systems" loading="lazy" width="1200" height="900" /></div></section>
  <section class="section section-tint"><div class="page-width"><div class="section-heading"><p class="eyebrow">How we work</p><h2>Clear steps. Shared understanding.</h2><p>Every engagement begins with a conversation and moves forward through an agreed scope.</p></div><div class="process-grid"><div class="process-step"><h3>Understand</h3><p>Discuss objectives, requirements and your existing environment.</p></div><div class="process-step"><h3>Design</h3><p>Explore suitable options and define a practical project scope.</p></div><div class="process-step"><h3>Implement</h3><p>Coordinate sourcing, configuration, integration and testing as agreed.</p></div><div class="process-step"><h3>Support and improve</h3><p>Consider ongoing support and optimization according to the engagement.</p></div></div></div></section>
  <section class="section page-width"><div class="section-heading"><p class="eyebrow">Who we work with</p><h2>Technology support for organizations at different stages.</h2><p>Tell us what your team needs to achieve, whether you are modernizing systems or starting with a specific project.</p></div><ul class="audience-list"><li>Small and medium-sized businesses</li><li>Growing businesses</li><li>Corporate IT teams</li><li>Professional services</li><li>Institutions</li><li>Startups</li></ul></section>
  <section class="section section-tint"><div class="page-width"><div class="section-topline"><div class="section-heading"><p class="eyebrow">From the insights desk</p><h2>Practical ideas for better technology decisions.</h2></div><a class="text-link" href="/insights/">All insights <span aria-hidden="true">→</span></a></div><div class="card-grid">{insights.slice(0,3).map(article=><article class="insight-card"><span class="insight-meta">{article.category} · {article.readTime}</span><h3>{article.title}</h3><p>{article.description}</p><a class="text-link" href={`/insights/${article.slug}/`}>Read article <span aria-hidden="true">→</span></a></article>)}</div></div></section>
  <section class="cta-band"><div class="page-width cta-inner"><div><p class="eyebrow" style="color:#d5e6ff">Start a conversation</p><h2>Let's find the right technology solution for your business.</h2><p>Tell us what you need to achieve. We'll help you explore options, define scope and identify practical next steps.</p></div><div class="cta-actions"><a class="button button-light" href="/contact/">Request a consultation <span aria-hidden="true">↗</span></a><a class="button button-outline" href="/contact/">Contact Overdott</a></div></div></section>
</BaseLayout>