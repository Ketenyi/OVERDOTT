---
import BaseLayout from '../layouts/BaseLayout.astro';
import TechVisual from '../components/TechVisual.astro';
import { findService } from '../data/services';
import { insights } from '../data/insights';

const capabilities = [
  {
    service: findService('website-development')!,
    number: '01',
    label: 'Web development',
    description: 'Corporate websites, landing pages and web applications designed to make your value clear.',
    icon: 'web',
  },
  {
    service: findService('software-development')!,
    number: '02',
    label: 'Software development',
    description: 'Business applications, integrations and digital products shaped around the way your team works.',
    icon: 'code',
  },
  {
    service: findService('cybersecurity')!,
    number: '03',
    label: 'Cybersecurity',
    description: 'Practical protection for identities, endpoints, email and networks, with risks clearly prioritized.',
    icon: 'shield',
  },
  {
    service: findService('technology-procurement')!,
    number: '04',
    label: 'Infrastructure & sourcing',
    description: 'Plan, source and integrate the technology your business depends on, with compatibility in view.',
    icon: 'source',
  },
];
---

<BaseLayout
  title="Web Development & Business Software | Overdott Technologies"
  description="Overdott builds corporate websites, web applications and business software, with cybersecurity, cloud, infrastructure and technology sourcing for organizations in Kenya."
>
  <section class="hero">
    <div class="hero-inner page-width">
      <div class="hero-copy">
        <p class="eyebrow">Web development · Business software · Kenya</p>
        <h1>Websites and software—<span>built for serious business.</span></h1>
        <p>We create corporate websites, web applications and business systems that make your offer clear and your operations work better—backed by cybersecurity, cloud and infrastructure expertise.</p>
        <div class="hero-actions">
          <a class="button" href="/contact/?interest=website-development">Start a website project <span aria-hidden="true">→</span></a>
          <a class="button button-outline" href="/solutions/">Explore our solutions <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-proof" aria-label="Our core capabilities">
          <span>Corporate websites</span>
          <span>Web applications</span>
          <span>Cybersecurity</span>
          <span>Technology sourcing</span>
        </div>
      </div>
      <TechVisual />
    </div>
  </section>

  <section class="section page-width">
    <div class="section-topline">
      <div class="section-heading">
        <p class="eyebrow">What we do</p>
        <h2>Your digital front door. The systems behind it.</h2>
        <p>Start with a website or connect a wider technology program. We bring design, software, security and infrastructure into one clear plan.</p>
      </div>
      <a class="text-link" href="/digital-services/">Explore digital services <span aria-hidden="true">→</span></a>
    </div>
    <div class="capability-grid">
      {capabilities.map((item) => (
        <a class="capability-card" href={`/services/${item.service.slug}/`}>
          <div class="capability-top">
            <span class="capability-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {item.icon === 'web' && <><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18M7 6.5h.01M10 6.5h.01M7 13h6M7 16h10" /></>}
                {item.icon === 'code' && <><path d="m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16" /></>}
                {item.icon === 'shield' && <><path d="M12 3 19 6v5c0 4.4-2.9 8-7 10-4.1-2-7-5.6-7-10V6l7-3Z" /><path d="m9 12 2 2 4-4" /></>}
                {item.icon === 'cloud' && <><path d="M7 18h10a4 4 0 0 0 .6-7.9A6 6 0 0 0 6.2 9 4.5 4.5 0 0 0 7 18Z" /><path d="M12 12v5M9.5 14.5 12 17l2.5-2.5" /></>}
                {item.icon === 'source' && <><path d="m12 3 9 5-9 5-9-5 9-5Z" /><path d="m3 12 9 5 9-5M3 16l9 5 9-5" /></>}
              </svg>
            </span>
            <span class="capability-number">{item.number}</span>
          </div>
          <h3>{item.label}</h3>
          <p>{item.description}</p>
          <span class="capability-link">Explore capability <span aria-hidden="true">↗</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="section section-dark web-showcase">
    <div class="page-width web-showcase-grid">
      <div class="web-showcase-copy">
        <p class="eyebrow">Corporate web development</p>
        <h2>A website that explains your value—and starts the right conversation.</h2>
        <p>We combine clear positioning, considered design and dependable development so your organization is easier to understand, find and approach.</p>
        <ul class="check-list">
          <li>Corporate websites and campaign landing pages</li>
          <li>Web applications and customer portal enquiries</li>
          <li>Responsive, accessible and maintainable by design</li>
        </ul>
        <div class="hero-actions">
          <a class="button" href="/contact/?interest=website-development">Discuss your website <span aria-hidden="true">→</span></a>
          <a class="text-link web-text-link" href="/services/website-development/">Explore web development <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <div class="web-blueprint" aria-label="Illustrative corporate website blueprint">
        <div class="web-browser-bar">
          <span class="web-browser-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="web-browser-address">yourorganization.com</span>
          <span class="web-browser-status"><i></i> Ready to build</span>
        </div>
        <div class="web-browser-body">
          <div class="web-blueprint-nav">
            <span class="web-blueprint-brand"><i>O</i> Organization</span>
            <span class="web-blueprint-links">Company&nbsp;&nbsp; Solutions&nbsp;&nbsp; Insights</span>
            <span class="web-blueprint-contact">Let’s talk <b>↗</b></span>
          </div>
          <div class="web-blueprint-hero">
            <div>
              <small>BUILT FOR WHAT’S NEXT</small>
              <strong>Expertise that moves business forward.</strong>
              <p>Clear positioning, useful content and a confident path to enquiry.</p>
              <span class="web-blueprint-button">Start a conversation <b>→</b></span>
            </div>
            <div class="web-blueprint-signal" aria-hidden="true">
              <span class="signal-ring signal-ring-one"></span>
              <span class="signal-ring signal-ring-two"></span>
              <span class="signal-ring signal-ring-three"></span>
              <span class="signal-core">
                <svg viewBox="0 0 24 24" fill="none"><path d="M5 18 10 7l4 7 2-4 3 8H5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>
              </span>
              <span class="signal-tag signal-tag-top">Strategy</span>
              <span class="signal-tag signal-tag-bottom">Growth</span>
            </div>
          </div>
          <div class="web-blueprint-cards">
            <div><span>01</span><strong>Clear positioning</strong><small>Make your value easy to understand.</small></div>
            <div><span>02</span><strong>Useful journeys</strong><small>Guide visitors toward the right next step.</small></div>
            <div><span>03</span><strong>Strong foundation</strong><small>Keep content and technology maintainable.</small></div>
          </div>
          <div class="web-blueprint-flow"><span>Strategy</span><b>→</b><span>Design</span><b>→</b><span>Development</span><b>→</b><span>Launch</span></div>
        </div>
        <span class="web-blueprint-caption">Illustrative blueprint · not a client website</span>
      </div>
    </div>
  </section>

  <section class="section section-tint">
    <div class="page-width product-spotlight">
      <div class="product-spotlight-copy">
        <p class="eyebrow">A product by Overdott</p>
        <h2>Meet Velldot ERP.<br />Your operations, in one workspace.</h2>
        <p>Bring projects, finance, people, procurement, inventory and sales into a modular business platform designed for growing organizations.</p>
        <ul class="check-list">
          <li>Start with a no-card trial</li>
          <li>Choose the modules your organization needs</li>
          <li>Connect Kenya-oriented workflows, including eTIMS and M-Pesa options</li>
        </ul>
        <div class="hero-actions">
          <a class="button" href="/velldot/">Explore Velldot ERP <span aria-hidden="true">→</span></a>
          <a class="button button-outline-dark" href="/velldot/#trial">See how to get started <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="product-ui" aria-label="Illustrative Velldot ERP workspace">
        <div class="product-ui-bar">
          <div class="product-ui-brand"><img src="/velldot-mark.svg" alt="" width="24" height="24" /><strong>velldot</strong></div>
          <span class="product-ui-status"><i></i> Organization workspace</span>
        </div>
        <div class="product-ui-body">
          <div class="product-ui-heading"><span>WORKSPACE OVERVIEW</span><strong>Everything your team needs to move forward.</strong></div>
          <div class="product-ui-modules">
            <div><span class="module-symbol module-blue">P</span><small>Projects</small><b>Plan &amp; deliver</b></div>
            <div><span class="module-symbol module-green">F</span><small>Finance</small><b>Report &amp; reconcile</b></div>
            <div><span class="module-symbol module-violet">H</span><small>People</small><b>Support your team</b></div>
          </div>
          <div class="product-ui-panel">
            <div class="product-ui-panel-head"><strong>Your operating toolkit</strong><span>MODULAR</span></div>
            <div class="module-row"><span>Sales &amp; CRM</span><i></i></div>
            <div class="module-row"><span>Procurement</span><i></i></div>
            <div class="module-row"><span>Inventory &amp; POS</span><i></i></div>
          </div>
        </div>
        <span class="product-ui-caption">Illustrative product view</span>
      </div>
    </div>
  </section>

  <section class="section section-dark process-section">
    <div class="page-width">
      <div class="section-topline">
        <div class="section-heading">
          <p class="eyebrow">How we work</p>
          <h2>Clear thinking before technical decisions.</h2>
          <p>Good delivery starts with the right questions. We keep requirements, responsibilities and next steps visible throughout the engagement.</p>
        </div>
        <a class="text-link web-text-link" href="/about/">How we work <span aria-hidden="true">→</span></a>
      </div>
      <div class="process-grid">
        <div class="process-step"><h3>Understand</h3><p>Learn the outcome, current environment, constraints and people involved.</p></div>
        <div class="process-step"><h3>Design</h3><p>Compare practical options and define a scope with clear assumptions.</p></div>
        <div class="process-step"><h3>Deliver</h3><p>Build, configure, integrate and test the agreed solution.</p></div>
        <div class="process-step"><h3>Support</h3><p>Hand over with clarity and agree ongoing support where needed.</p></div>
      </div>
    </div>
  </section>

  <section class="section section-tint">
    <div class="page-width">
      <div class="section-topline">
        <div class="section-heading">
          <p class="eyebrow">From the insights desk</p>
          <h2>Useful context for better technology decisions.</h2>
        </div>
        <a class="text-link" href="/insights/">All insights <span aria-hidden="true">→</span></a>
      </div>
      <div class="card-grid">
        {insights.slice(0, 3).map((article) => (
          <article class="insight-card">
            <span class="insight-meta">{article.category} · {article.readTime}</span>
            <h3>{article.title}</h3>
            <p>{article.description}</p>
            <a class="text-link" href={`/insights/${article.slug}/`}>Read article <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="page-width cta-inner">
      <div>
        <p class="eyebrow">Start a conversation</p>
        <h2>Planning a corporate website or digital platform?</h2>
        <p>Tell us what your organization needs to achieve. We’ll help define the right design, technology and next steps.</p>
      </div>
      <div class="cta-actions">
        <a class="button button-light" href="/contact/?interest=website-development">Discuss your project <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .capability-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .capability-card {
    position: relative;
    display: flex;
    min-height: 246px;
    overflow: hidden;
    padding: 24px 21px 21px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    flex-direction: column;
    background: #fff;
    transition: border-color 200ms ease, box-shadow 200ms ease, transform 200ms ease;
  }

  .capability-card:first-child {
    color: #fff;
    border-color: var(--navy);
    background:
      radial-gradient(circle at 88% 12%, rgba(38, 117, 232, 0.26), transparent 38%),
      var(--navy);
  }

  .capability-card:first-child::after {
    position: absolute;
    right: -90px;
    bottom: -120px;
    width: 280px;
    height: 280px;
    border: 1px solid rgba(138, 184, 255, 0.13);
    border-radius: 50%;
    content: '';
  }

  .capability-top {
    display: flex;
    margin-bottom: 23px;
    align-items: center;
    justify-content: space-between;
  }

  .capability-icon {
    display: grid;
    width: 42px;
    height: 42px;
    border-radius: 11px;
    place-items: center;
    color: var(--blue);
    background: var(--mist-blue);
  }

  .capability-card:first-child .capability-icon {
    color: #a8caff;
    background: rgba(138, 184, 255, 0.12);
  }

  .capability-icon svg {
    width: 22px;
    height: 22px;
  }

  .capability-number {
    color: #8b99ac;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .capability-card:first-child .capability-number {
    color: #7f96b3;
  }

  .capability-card h3 {
    margin-bottom: 10px;
    font-size: 1.25rem;
  }

  .capability-card:first-child h3 {
    color: #fff;
  }

  .capability-card p {
    max-width: 470px;
    margin-bottom: 20px;
    font-size: 13px;
    line-height: 1.6;
  }

  .capability-card:first-child p {
    color: #b7c6d9;
  }

  .capability-link {
    display: inline-flex;
    margin-top: auto;
    align-items: center;
    gap: 9px;
    color: var(--blue-dark);
    font-size: 13px;
    font-weight: 700;
  }

  .capability-card:first-child .capability-link {
    color: #a8caff;
  }

  .capability-link span {
    transition: transform 180ms ease;
  }

  .web-showcase-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(480px, 1.15fr);
    align-items: center;
    gap: clamp(40px, 6vw, 76px);
  }

  .web-showcase-copy h2 {
    margin-bottom: 18px;
    font-size: clamp(2rem, 3.4vw, 3rem);
  }

  .web-showcase-copy > p:not(.eyebrow) {
    margin-bottom: 0;
    font-size: 15px;
  }

  .web-showcase-copy .check-list {
    margin-block: 20px 24px;
    gap: 10px;
  }

  .web-showcase-copy .check-list li {
    font-size: 13px;
  }

  .web-text-link {
    color: var(--blue-light);
    font-size: 13px;
  }

  .process-section .section-heading {
    max-width: 680px;
  }

  .process-section .process-grid {
    gap: 12px;
  }

  .process-section .process-step {
    min-height: 158px;
    padding: 20px;
    border: 1px solid rgba(158, 197, 255, 0.15);
    border-radius: 12px;
    background: rgba(13, 35, 66, 0.68);
  }

  .process-section .process-step::before {
    display: grid;
    width: 28px;
    height: 28px;
    margin-bottom: 18px;
    border: 1px solid rgba(138, 184, 255, 0.2);
    border-radius: 8px;
    place-items: center;
    color: var(--blue-light);
    background: rgba(138, 184, 255, 0.08);
    font-size: 10px;
  }

  .process-section .process-step::after {
    display: none;
  }

  .process-section .process-step h3 {
    margin-bottom: 8px;
    font-size: 1.05rem;
  }

  .process-section .process-step p {
    font-size: 13px;
  }

  .web-blueprint {
    position: relative;
    min-width: 0;
    border: 1px solid rgba(158, 197, 255, 0.24);
    border-radius: 16px;
    background: #f5f8fc;
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.3);
    transform: perspective(1200px) rotateY(-3deg) rotateX(1deg);
  }

  .web-blueprint::after {
    position: absolute;
    z-index: -1;
    inset: 12% -8% -8% 12%;
    border: 1px solid rgba(138, 184, 255, 0.15);
    border-radius: 18px;
    content: '';
  }

  .web-browser-bar {
    display: flex;
    min-height: 38px;
    padding: 0 13px;
    border-bottom: 1px solid #dce4ef;
    align-items: center;
    gap: 12px;
    background: #fff;
  }

  .web-browser-dots {
    display: flex;
    gap: 4px;
  }

  .web-browser-dots i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #d2dce8;
  }

  .web-browser-dots i:first-child {
    background: #8ab8ff;
  }

  .web-browser-address {
    min-width: 0;
    padding: 4px 12px;
    border-radius: 5px;
    flex: 1;
    color: #77869a;
    background: #f2f5f9;
    font-size: 8px;
    text-align: center;
  }

  .web-browser-status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #698077;
    font-size: 8px;
    white-space: nowrap;
  }

  .web-browser-status i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #2baf76;
  }

  .web-browser-body {
    padding: 16px;
  }

  .web-blueprint-nav {
    display: flex;
    padding-bottom: 13px;
    border-bottom: 1px solid #e0e7f0;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .web-blueprint-brand {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--navy);
    font-family: var(--heading);
    font-size: 10px;
    font-weight: 700;
  }

  .web-blueprint-brand i {
    display: grid;
    width: 18px;
    height: 18px;
    border-radius: 5px;
    place-items: center;
    color: #fff;
    background: var(--blue);
    font-size: 9px;
    font-style: normal;
  }

  .web-blueprint-links {
    color: #7a889b;
    font-size: 7px;
  }

  .web-blueprint-contact {
    padding: 5px 8px;
    border-radius: 4px;
    color: #fff;
    background: var(--navy);
    font-size: 7px;
    font-weight: 700;
  }

  .web-blueprint-contact b {
    margin-left: 3px;
    color: var(--blue-light);
  }

  .web-blueprint-hero {
    display: grid;
    min-height: 180px;
    padding: 22px 0;
    grid-template-columns: minmax(0, 1.25fr) minmax(130px, 0.75fr);
    align-items: center;
    gap: 18px;
  }

  .web-blueprint-hero small {
    display: block;
    margin-bottom: 8px;
    color: var(--blue);
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .web-blueprint-hero strong {
    display: block;
    max-width: 280px;
    margin-bottom: 8px;
    color: var(--ink);
    font-family: var(--heading);
    font-size: clamp(1.25rem, 2.2vw, 1.8rem);
    letter-spacing: -0.045em;
    line-height: 1.13;
  }

  .web-blueprint-hero p {
    max-width: 260px;
    margin-bottom: 13px;
    color: #68778b;
    font-size: 8px;
    line-height: 1.55;
  }

  .web-blueprint-button {
    display: inline-flex;
    padding: 7px 10px;
    border-radius: 5px;
    align-items: center;
    gap: 8px;
    color: #fff;
    background: var(--blue);
    font-size: 7px;
    font-weight: 700;
  }

  .web-blueprint-button b {
    color: #cfe2ff;
  }

  .web-blueprint-signal {
    position: relative;
    display: grid;
    width: 136px;
    height: 136px;
    margin-inline: auto;
    place-items: center;
  }

  .signal-ring {
    position: absolute;
    border: 1px solid #cadaf0;
    border-radius: 50%;
  }

  .signal-ring-one {
    width: 126px;
    height: 126px;
  }

  .signal-ring-two {
    width: 92px;
    height: 92px;
    border-style: dashed;
  }

  .signal-ring-three {
    width: 58px;
    height: 58px;
    border-color: #9fc3f7;
    background: #eaf2ff;
  }

  .signal-core {
    position: relative;
    z-index: 1;
    display: grid;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    place-items: center;
    color: #fff;
    background: var(--blue);
    box-shadow: 0 10px 24px rgba(38, 117, 232, 0.22);
  }

  .signal-core svg {
    width: 24px;
    height: 24px;
  }

  .signal-tag {
    position: absolute;
    z-index: 2;
    padding: 4px 7px;
    border: 1px solid #d9e5f5;
    border-radius: 4px;
    color: #48627f;
    background: #fff;
    box-shadow: 0 5px 12px rgba(7, 23, 44, 0.06);
    font-size: 7px;
    font-weight: 700;
  }

  .signal-tag-top {
    top: 8px;
    right: 0;
  }

  .signal-tag-bottom {
    bottom: 8px;
    left: 0;
  }

  .web-blueprint-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 7px;
  }

  .web-blueprint-cards > div {
    display: grid;
    min-height: 78px;
    padding: 10px;
    border: 1px solid #dfe7f1;
    border-radius: 7px;
    align-content: start;
    background: #fff;
  }

  .web-blueprint-cards span {
    margin-bottom: 7px;
    color: var(--blue);
    font-size: 7px;
    font-weight: 700;
  }

  .web-blueprint-cards strong {
    margin-bottom: 4px;
    color: #26384f;
    font-family: var(--heading);
    font-size: 9px;
  }

  .web-blueprint-cards small {
    color: #78869a;
    font-size: 7px;
    line-height: 1.45;
  }

  .web-blueprint-flow {
    display: flex;
    padding-top: 13px;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    color: #5e6f84;
    font-size: 7px;
    font-weight: 600;
  }

  .web-blueprint-flow b {
    color: var(--blue);
  }

  .web-blueprint-caption {
    display: block;
    padding: 8px 16px;
    border-top: 1px solid #dce4ef;
    border-radius: 0 0 16px 16px;
