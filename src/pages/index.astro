---
import BaseLayout from '../layouts/BaseLayout.astro';
import TechVisual from '../components/TechVisual.astro';
import { servicePillars } from '../data/services';
import { insights } from '../data/insights';

const challenges = [
  ['Disconnected business processes', 'Too much time spent moving information between spreadsheets, emails and different systems.'],
  ['Manual and repetitive work', 'Processes that depend on paperwork, repeated data entry and manual approvals.'],
  ['Limited digital presence', 'Businesses struggling to present their services professionally and connect with customers online.'],
  ['Unreliable technology environments', 'IT infrastructure that requires better maintenance, monitoring and technical management.'],
];

const steps = [
  ['Understand', 'We start by understanding your business, your challenges and what you want to achieve.'],
  ['Design', 'We identify the right approach and develop a solution aligned with your requirements.'],
  ['Deliver', 'We implement, configure and test the solution with attention to functionality and usability.'],
  ['Support', 'We help you maintain, improve and get continued value from your technology.'],
];

const principles = [
  ['Practical Approach', 'We focus on understanding the business problem before recommending technology.'],
  ['Connected Thinking', 'We consider how your applications, processes, people and infrastructure work together.'],
  ['Solutions That Fit', 'We believe effective technology should fit the needs and scale of your business.'],
  ['Long-Term Perspective', 'We aim to build lasting relationships by helping businesses continuously improve their technology.'],
];
---

<BaseLayout
  title="Overdott Technologies | Digital Solutions, Software & IT Services"
  description="Overdott Technologies helps businesses with website development, custom software, business automation and IT infrastructure solutions."
>
  <section class="hero">
    <div class="hero-inner page-width">
      <div class="hero-copy">
        <p class="eyebrow">Technology solutions for modern businesses</p>
        <h1>Technology.<br /><span class="editorial-accent">Built for Business.</span></h1>
        <p>We design and deliver digital solutions that help businesses simplify operations, improve productivity and grow with confidence.</p>
        <div class="hero-actions">
          <a class="button" href="/contact/">Let's Discuss Your Project <span aria-hidden="true">→</span></a>
          <a class="button button-outline" href="/services/">Explore Our Services <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-proof" aria-label="Our core capabilities">
          <span>Websites &amp; applications</span>
          <span>Business automation</span>
          <span>IT infrastructure</span>
        </div>
      </div>
      <TechVisual />
    </div>
  </section>

  <section class="section section-compact page-width home-intro">
    <div>
      <p class="eyebrow">Discover Overdott</p>
      <h2>Better business starts with better technology.</h2>
      <p>Technology should make running a business easier, not more complicated.</p>
      <p>At Overdott Technologies, we help businesses turn operational challenges into practical digital solutions. Whether you need a professional website, a custom business application, automated workflows or reliable IT infrastructure, we focus on delivering solutions that address real business needs.</p>
      <a class="text-link" href="/about/">Discover Overdott <span aria-hidden="true">→</span></a>
    </div>
    <aside class="home-intro-panel" aria-label="Our connected approach">
      <p class="hero-panel-label">One practical perspective</p>
      <div><span>01</span><strong>Digital experience</strong><small>Websites, applications and integrations</small></div>
      <div><span>02</span><strong>Business systems</strong><small>Workflows, data and automation</small></div>
      <div><span>03</span><strong>Technology foundation</strong><small>Infrastructure, security and support</small></div>
    </aside>
  </section>

  <section class="section page-width">
    <div class="section-topline">
      <div class="section-heading">
        <p class="eyebrow">What we do</p>
        <h2>Practical technology, designed around your business.</h2>
        <p>Practical technology solutions designed around the way your business works.</p>
      </div>
      <a class="text-link" href="/services/">Explore all services <span aria-hidden="true">→</span></a>
    </div>
    <div class="capability-grid pillar-grid">
      {servicePillars.map((pillar) => (
        <a class="capability-card" href={pillar.href}>
          <div class="capability-top">
            <span class="capability-number">Service {pillar.number}</span>
            <span class="capability-direction" aria-hidden="true">↗</span>
          </div>
          <h3>{pillar.title}</h3>
          <p>{pillar.summary}</p>
          <span class="capability-link">Explore service <span aria-hidden="true">↗</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="section section-compact section-tint">
    <div class="page-width">
      <div class="section-heading">
        <p class="eyebrow">Business challenges</p>
        <h2>Technology should solve problems, not create new ones.</h2>
      </div>
      <div class="challenge-grid">
        {challenges.map(([title, description], index) => (
          <article class="challenge-card">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
      <div class="challenge-footer">
        <p>We work with businesses to identify these challenges and implement technology that makes day-to-day work clearer and more manageable.</p>
        <a class="text-link" href="/contact/">Tell Us What You Need <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section section-dark web-showcase">
    <div class="page-width web-showcase-grid">
      <div class="web-showcase-copy">
        <p class="eyebrow">Corporate web development</p>
        <h2>A stronger digital presence starts with a clearer business story.</h2>
        <p>Your website is often the first interaction customers have with your business. We design and develop professional digital platforms that communicate your offer, support customer enquiries and create useful experiences.</p>
        <ul class="check-list">
          <li>Corporate websites, e-commerce and campaign pages</li>
          <li>Custom web applications and system integrations</li>
          <li>Responsive, accessible and maintainable by design</li>
        </ul>
        <div class="hero-actions">
          <a class="button" href="/contact/?interest=digital-development">Discuss a Website Project <span aria-hidden="true">→</span></a>
          <a class="text-link web-text-link" href="/services/website-development/">Explore web development <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <div class="web-blueprint" aria-label="Illustrative corporate website blueprint">
        <div class="web-browser-bar">
          <span class="web-browser-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="web-browser-address">yourorganization.com</span>
          <span class="web-browser-status"><i></i> Ready to build</span>
        </div>
        <div class="web-browser-body">
          <div class="web-blueprint-nav">
            <span class="web-blueprint-brand"><i>O</i> Organization</span>
            <span class="web-blueprint-links">Company&nbsp;&nbsp; Solutions&nbsp;&nbsp; Insights</span>
            <span class="web-blueprint-contact">Let’s talk <b>↗</b></span>
          </div>
          <div class="web-blueprint-hero">
            <div>
              <small>BUILT FOR WHAT’S NEXT</small>
              <strong>Expertise that moves business forward.</strong>
              <p>Clear positioning, useful content and a confident path to enquiry.</p>
              <span class="web-blueprint-button">Start a conversation <b>→</b></span>
            </div>
            <div class="web-blueprint-signal" aria-hidden="true">
              <div><span>01</span><strong>Positioning</strong></div>
              <div><span>02</span><strong>Experience</strong></div>
              <div><span>03</span><strong>Technology</strong></div>
            </div>
          </div>
          <div class="web-blueprint-cards">
            <div><span>01</span><strong>Clear positioning</strong><small>Make your value easy to understand.</small></div>
            <div><span>02</span><strong>Useful journeys</strong><small>Guide visitors toward the right next step.</small></div>
            <div><span>03</span><strong>Strong foundation</strong><small>Keep content and technology maintainable.</small></div>
          </div>
          <div class="web-blueprint-flow"><span>Strategy</span><b>→</b><span>Design</span><b>→</b><span>Development</span><b>→</b><span>Launch</span></div>
        </div>
        <span class="web-blueprint-caption">Illustrative blueprint · not a client website</span>
      </div>
    </div>
  </section>

  <section class="section section-tint">
    <div class="page-width product-spotlight">
      <div class="product-spotlight-copy">
        <p class="eyebrow">A product initiative by Overdott</p>
        <h2>Introducing Velldot.<br />Business software, simplified.</h2>
        <p>Velldot is our software product initiative focused on developing practical business applications that help organizations manage operations, people and projects more effectively.</p>
        <ul class="check-list">
          <li>Velldot ERP with verified business modules and capabilities</li>
          <li>Velldot HR and Velldot Projects in development</li>
          <li>Early-access, deployment and licensing discussions by enquiry</li>
        </ul>
        <p class="product-status-note">Product availability and deployment arrangements are confirmed by enquiry.</p>
        <div class="hero-actions">
          <a class="button" href="/velldot/">Explore Velldot <span aria-hidden="true">→</span></a>
          <a class="button button-outline-dark" href="/contact/?interest=velldot-early-access#enquiry">Register Interest <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="product-ui" aria-label="Illustrative Velldot ERP workspace">
        <div class="product-ui-bar">
          <div class="product-ui-brand"><img src="/velldot-mark.svg" alt="" width="24" height="24" /><strong>velldot</strong></div>
          <span class="product-ui-status"><i></i> Organization workspace</span>
        </div>
        <div class="product-ui-body">
          <div class="product-ui-heading"><span>WORKSPACE OVERVIEW</span><strong>Everything your team needs to move forward.</strong></div>
          <div class="product-ui-modules">
            <div><span class="module-symbol module-blue">P</span><small>Projects</small><b>Plan &amp; deliver</b></div>
            <div><span class="module-symbol module-green">F</span><small>Finance</small><b>Report &amp; reconcile</b></div>
            <div><span class="module-symbol module-violet">H</span><small>People</small><b>Support your team</b></div>
          </div>
          <div class="product-ui-panel">
            <div class="product-ui-panel-head"><strong>Your operating toolkit</strong><span>MODULAR</span></div>
            <div class="module-row"><span>Sales &amp; CRM</span><i></i></div>
            <div class="module-row"><span>Procurement</span><i></i></div>
            <div class="module-row"><span>Inventory &amp; POS</span><i></i></div>
          </div>
        </div>
        <span class="product-ui-caption">Illustrative product view</span>
      </div>
    </div>
  </section>

  <section class="section section-dark process-section">
    <div class="page-width">
      <div class="section-topline">
        <div class="section-heading">
          <p class="eyebrow">Our approach</p>
          <h2>Simple thinking. Practical solutions.</h2>
          <p>Good delivery starts with the right questions and a clear understanding of the outcome you need.</p>
        </div>
        <a class="text-link web-text-link" href="/about/">How we work <span aria-hidden="true">→</span></a>
      </div>
      <div class="process-grid">
        {steps.map(([title, description]) => (
          <div class="process-step"><h3>{title}</h3><p>{description}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section page-width">
    <div class="section-heading">
      <p class="eyebrow">Why Overdott</p>
      <h2>Technology with a practical perspective.</h2>
    </div>
    <div class="why-grid">
      {principles.map(([title, description], index) => (
        <article class="why-item">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{title}</h3>
          <p>{description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-tint">
    <div class="page-width">
      <div class="section-topline">
        <div class="section-heading">
          <p class="eyebrow">From the insights desk</p>
          <h2>Useful context for better technology decisions.</h2>
        </div>
        <a class="text-link" href="/insights/">All insights <span aria-hidden="true">→</span></a>
      </div>
      <div class="card-grid">
        {insights.slice(0, 3).map((article) => (
          <article class="insight-card">
            <span class="insight-meta">{article.category} · {article.readTime}</span>
            <h3>{article.title}</h3>
            <p>{article.description}</p>
            <a class="text-link" href={`/insights/${article.slug}/`}>Read article <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="page-width cta-inner">
      <div>
        <p class="eyebrow">Start a conversation</p>
        <h2>Have a business challenge we can help solve?</h2>
        <p>Let's explore how the right technology can make your business work better.</p>
      </div>
      <div class="cta-actions">
        <a class="button button-light" href="/contact/">Start a Conversation <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.65fr);
    align-items: center;
    gap: clamp(36px, 6vw, 72px);
  }

  .home-intro h2 {
    max-width: 700px;
    margin-bottom: 18px;
  }

  .home-intro > div > p:not(.eyebrow) {
    max-width: 720px;
    font-size: 15px;
  }

  .home-intro .text-link {
    margin-top: 8px;
  }

  .home-intro-panel {
    padding: 20px 0 0;
    border: 0;
    border-top: 1px solid var(--line);
    background: transparent;
  }

  .home-intro-panel > div {
    display: grid;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 3px 10px;
  }

  .home-intro-panel > div:last-child {
    padding-bottom: 0;
  }

  .home-intro-panel > div > span {
    padding-top: 2px;
    grid-row: 1 / span 2;
    color: var(--blue-dark);
    font-size: 10px;
    font-weight: 800;
  }

  .home-intro-panel strong {
    color: var(--ink);
    font-family: var(--heading);
    font-size: 14px;
  }

  .home-intro-panel small {
    color: var(--body);
    font-size: 11px;
    line-height: 1.5;
  }

  .capability-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .pillar-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .pillar-grid .capability-card {
    min-height: 268px;
  }

  .pillar-grid .capability-card h3 {
    max-width: 310px;
    font-size: 1.18rem;
    line-height: 1.35;
  }

  .challenge-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .challenge-card {
    min-width: 0;
    padding: 22px 22px 0 0;
    border: 0;
    border-top: 1px solid #cdd2ce;
    background: transparent;
  }

  .challenge-card + .challenge-card {
    padding-left: 22px;
    border-left: 1px solid #cdd2ce;
  }

  .challenge-card > span {
    display: block;
    margin-bottom: 24px;
    color: var(--blue-dark);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .challenge-card h3 {
    margin-bottom: 10px;
    font-size: 1.02rem;
    line-height: 1.4;
  }

  .challenge-card p {
    margin-bottom: 0;
    font-size: 12px;
    line-height: 1.7;
  }

  .challenge-footer {
    display: flex;
    margin-top: 20px;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .challenge-footer p {
    max-width: 710px;
    margin-bottom: 0;
    font-size: 13px;
  }

  .challenge-footer .text-link {
    flex: 0 0 auto;
    font-size: 13px;
  }

  .product-status-note {
    margin: -8px 0 20px;
    color: #5d7089;
    font-size: 12px;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .why-item {
    min-width: 0;
    padding: 22px 22px 0 0;
    border: 0;
    border-top: 1px solid var(--line);
    background: transparent;
  }

  .why-item + .why-item {
    padding-left: 22px;
    border-left: 1px solid var(--line);
  }

  .why-item > span {
    display: block;
    margin-bottom: 24px;
    color: var(--blue-dark);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .why-item h3 {
    margin-bottom: 10px;
    font-size: 1rem;
  }

  .why-item p {
    margin-bottom: 0;
    font-size: 12px;
    line-height: 1.7;
  }

  .capability-card {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 246px;
    padding: 24px 24px 22px 0;
    border: 0;
    border-top: 1px solid var(--line);
    border-right: 1px solid var(--line);
    flex-direction: column;
    background: transparent;
    transition: border-color 200ms ease;
  }

  .capability-card:last-child {
    padding-right: 0;
    border-right: 0;
  }

  .capability-top {
    display: flex;
    margin-bottom: 32px;
    align-items: center;
    justify-content: space-between;
  }

  .capability-number {
    color: #778797;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .capability-direction {
    color: var(--blue);
    font-size: 16px;
    transition: transform 180ms ease;
  }

  .capability-card h3 {
    max-width: 330px;
    margin-bottom: 13px;
    font-size: 1.35rem;
    line-height: 1.3;
  }

  .capability-card p {
    max-width: 420px;
    margin-bottom: 24px;
    font-size: 13px;
    line-height: 1.7;
  }

  .capability-link {
    display: inline-flex;
    margin-top: auto;
    align-items: center;
    gap: 9px;
    color: var(--blue-dark);
    font-size: 13px;
    font-weight: 700;
  }

  .capability-link span {
    transition: transform 180ms ease;
  }

  .web-showcase-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(480px, 1.15fr);
    align-items: center;
    gap: clamp(40px, 6vw, 76px);
  }

  .web-showcase-copy h2 {
    margin-bottom: 18px;
    font-size: clamp(2rem, 3.4vw, 3rem);
  }

  .web-showcase-copy > p:not(.eyebrow) {
    margin-bottom: 0;
    font-size: 15px;
  }

  .web-showcase-copy .check-list {
    margin-block: 20px 24px;
    gap: 10px;
  }

  .web-showcase-copy .check-list li {
    font-size: 13px;
  }

  .web-text-link {
    color: var(--blue-light);
    font-size: 13px;
  }

  .process-section .section-heading {
    max-width: 680px;
  }

  .process-section .process-grid {
    gap: 0;
  }

  .process-section .process-step {
    min-height: 158px;
    padding: 22px 24px 0 0;
    border: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    background: transparent;
  }

  .process-section .process-step + .process-step {
    padding-left: 24px;
    border-left: 1px solid rgba(255, 255, 255, 0.12);
  }

  .process-section .process-step::before {
    display: block;
    margin-bottom: 22px;
    color: var(--blue-light);
    font-size: 10px;
  }

  .process-section .process-step::after {
    display: none;
  }

  .process-section .process-step h3 {
    margin-bottom: 8px;
    font-size: 1.05rem;
  }

  .process-section .process-step p {
    font-size: 13px;
  }

  .web-blueprint {
    position: relative;
    min-width: 0;
    border: 1px solid rgba(158, 197, 255, 0.28);
    border-radius: 4px;
    background: #f5f5f1;
  }

  .web-browser-bar {
    display: flex;
    min-height: 38px;
    padding: 0 13px;
    border-bottom: 1px solid #dce4ef;
    align-items: center;
    gap: 12px;
    background: #fff;
  }

  .web-browser-dots {
    display: flex;
    gap: 4px;
  }

  .web-browser-dots i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #d2dce8;
  }

  .web-browser-dots i:first-child {
    background: #8ab8ff;
  }

  .web-browser-address {
    min-width: 0;
    padding: 4px 12px;
    border-radius: 4px;
    flex: 1;
    color: #77869a;
    background: #f2f5f9;
    font-size: 8px;
    text-align: center;
  }

  .web-browser-status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #698077;
    font-size: 8px;
    white-space: nowrap;
  }

  .web-browser-status i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #2baf76;
  }

  .web-browser-body {
    padding: 16px;
  }

  .web-blueprint-nav {
    display: flex;
    padding-bottom: 13px;
    border-bottom: 1px solid #e0e7f0;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .web-blueprint-brand {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--navy);
    font-family: var(--heading);
    font-size: 10px;
    font-weight: 700;
  }

  .web-blueprint-brand i {
    display: grid;
    width: 18px;
    height: 18px;
    border-radius: 4px;
    place-items: center;
    color: #fff;
    background: var(--blue);
    font-size: 9px;
    font-style: normal;
  }

  .web-blueprint-links {
    color: #7a889b;
    font-size: 7px;
  }

  .web-blueprint-contact {
    padding: 5px 8px;
    border-radius: 4px;
    color: #fff;
    background: var(--navy);
    font-size: 7px;
    font-weight: 700;
  }

  .web-blueprint-contact b {
    margin-left: 3px;
    color: var(--blue-light);
  }

  .web-blueprint-hero {
    display: grid;
    min-height: 180px;
    padding: 22px 0;
    grid-template-columns: minmax(0, 1.25fr) minmax(130px, 0.75fr);
    align-items: center;
    gap: 18px;
  }

  .web-blueprint-hero small {
    display: block;
    margin-bottom: 8px;
    color: var(--blue);
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .web-blueprint-hero strong {
    display: block;
    max-width: 280px;
    margin-bottom: 8px;
    color: var(--ink);
    font-family: var(--heading);
    font-size: clamp(1.25rem, 2.2vw, 1.8rem);
    letter-spacing: -0.045em;
    line-height: 1.13;
  }

  .web-blueprint-hero p {
    max-width: 260px;
    margin-bottom: 13px;
    color: #68778b;
    font-size: 8px;
    line-height: 1.55;
  }

  .web-blueprint-button {
    display: inline-flex;
