---
import BaseLayout from '../layouts/BaseLayout.astro';
import TechVisual from '../components/TechVisual.astro';
import { findService } from '../data/services';
import { insights } from '../data/insights';

const capabilities = [
  {
    service: findService('software-development')!,
    number: '01',
    label: 'Software development',
    description: 'Business applications, integrations and digital products shaped around the way your team works.',
    icon: 'code',
  },
  {
    service: findService('cybersecurity')!,
    number: '02',
    label: 'Cybersecurity',
    description: 'Practical protection for identities, endpoints, email and networks, with risks clearly prioritized.',
    icon: 'shield',
  },
  {
    service: findService('infrastructure')!,
    number: '03',
    label: 'Infrastructure & cloud',
    description: 'Plan, source and integrate the systems your business depends on, with compatibility in view.',
    icon: 'cloud',
  },
  {
    service: findService('technology-procurement')!,
    number: '04',
    label: 'Technology sourcing',
    description: 'Evaluate hardware, software and licensing options before committing to a purchase.',
    icon: 'source',
  },
];
---

<BaseLayout
  title="Overdott Technologies | Software, Cybersecurity & IT Solutions"
  description="Overdott develops business software, sources technology and delivers cybersecurity, infrastructure and digital solutions for organizations in Kenya."
>
  <section class="hero">
    <div class="hero-inner page-width">
      <div class="hero-copy">
        <p class="eyebrow">Software development · Cybersecurity · Kenya</p>
        <h1>Software, security and systems—<span>built to work together.</span></h1>
        <p>Overdott helps organizations build business software, source technology and strengthen cybersecurity, with infrastructure, cloud and digital delivery considered as one connected picture.</p>
        <div class="hero-actions">
          <a class="button" href="/solutions/">Explore our solutions <span aria-hidden="true">→</span></a>
          <a class="button button-outline" href="/velldot/">Meet Velldot ERP <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-proof" aria-label="Our core capabilities">
          <span>Custom software</span>
          <span>Cybersecurity</span>
          <span>IT infrastructure</span>
          <span>Technology sourcing</span>
        </div>
      </div>
      <TechVisual />
    </div>
  </section>

  <section class="section page-width">
    <div class="section-topline">
      <div class="section-heading">
        <p class="eyebrow">What we do</p>
        <h2>One technology partner. Fewer disconnected decisions.</h2>
        <p>From a single application to a broader technology program, we connect the technical pieces to the outcome your organization needs.</p>
      </div>
      <a class="text-link" href="/digital-services/">Explore digital services <span aria-hidden="true">→</span></a>
    </div>
    <div class="capability-grid">
      {capabilities.map((item) => (
        <a class="capability-card" href={`/services/${item.service.slug}/`}>
          <div class="capability-top">
            <span class="capability-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {item.icon === 'code' && <><path d="m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16" /></>}
                {item.icon === 'shield' && <><path d="M12 3 19 6v5c0 4.4-2.9 8-7 10-4.1-2-7-5.6-7-10V6l7-3Z" /><path d="m9 12 2 2 4-4" /></>}
                {item.icon === 'cloud' && <><path d="M7 18h10a4 4 0 0 0 .6-7.9A6 6 0 0 0 6.2 9 4.5 4.5 0 0 0 7 18Z" /><path d="M12 12v5M9.5 14.5 12 17l2.5-2.5" /></>}
                {item.icon === 'source' && <><path d="m12 3 9 5-9 5-9-5 9-5Z" /><path d="m3 12 9 5 9-5M3 16l9 5 9-5" /></>}
              </svg>
            </span>
            <span class="capability-number">{item.number}</span>
          </div>
          <h3>{item.label}</h3>
          <p>{item.description}</p>
          <span class="capability-link">Explore capability <span aria-hidden="true">↗</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="section section-tint">
    <div class="page-width product-spotlight">
      <div class="product-spotlight-copy">
        <p class="eyebrow">A product by Overdott</p>
        <h2>Meet Velldot ERP.<br />Your operations, in one workspace.</h2>
        <p>Bring projects, finance, people, procurement, inventory and sales into a modular business platform designed for growing organizations.</p>
        <ul class="check-list">
          <li>Start with a no-card trial</li>
          <li>Choose the modules your organization needs</li>
          <li>Connect Kenya-oriented workflows, including eTIMS and M-Pesa options</li>
        </ul>
        <div class="hero-actions">
          <a class="button" href="/velldot/">Explore Velldot ERP <span aria-hidden="true">→</span></a>
          <a class="button button-outline-dark" href="/velldot/#trial">See how to get started <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="product-ui" aria-label="Illustrative Velldot ERP workspace">
        <div class="product-ui-bar">
          <div class="product-ui-brand"><img src="/velldot-mark.svg" alt="" width="24" height="24" /><strong>velldot</strong></div>
          <span class="product-ui-status"><i></i> Organization workspace</span>
        </div>
        <div class="product-ui-body">
          <div class="product-ui-heading"><span>WORKSPACE OVERVIEW</span><strong>Everything your team needs to move forward.</strong></div>
          <div class="product-ui-modules">
            <div><span class="module-symbol module-blue">P</span><small>Projects</small><b>Plan &amp; deliver</b></div>
            <div><span class="module-symbol module-green">F</span><small>Finance</small><b>Report &amp; reconcile</b></div>
            <div><span class="module-symbol module-violet">H</span><small>People</small><b>Support your team</b></div>
          </div>
          <div class="product-ui-panel">
            <div class="product-ui-panel-head"><strong>Your operating toolkit</strong><span>MODULAR</span></div>
            <div class="module-row"><span>Sales &amp; CRM</span><i></i></div>
            <div class="module-row"><span>Procurement</span><i></i></div>
            <div class="module-row"><span>Inventory &amp; POS</span><i></i></div>
          </div>
        </div>
        <span class="product-ui-caption">Illustrative product view</span>
      </div>
    </div>
  </section>

  <section class="section page-width">
    <div class="section-heading">
      <p class="eyebrow">How we work</p>
      <h2>Clear thinking before technical decisions.</h2>
      <p>Good delivery starts with the right questions. We keep requirements, responsibilities and next steps visible throughout the engagement.</p>
    </div>
    <div class="process-grid">
      <div class="process-step"><h3>Understand</h3><p>Learn the outcome, current environment, constraints and people involved.</p></div>
      <div class="process-step"><h3>Design</h3><p>Compare practical options and define a scope with clear assumptions.</p></div>
      <div class="process-step"><h3>Deliver</h3><p>Build, configure, integrate and test the agreed solution.</p></div>
      <div class="process-step"><h3>Support</h3><p>Hand over with clarity and agree ongoing support where needed.</p></div>
    </div>
  </section>

  <section class="section section-tint">
    <div class="page-width">
      <div class="section-topline">
        <div class="section-heading">
          <p class="eyebrow">From the insights desk</p>
          <h2>Useful context for better technology decisions.</h2>
        </div>
        <a class="text-link" href="/insights/">All insights <span aria-hidden="true">→</span></a>
      </div>
      <div class="card-grid">
        {insights.slice(0, 3).map((article) => (
          <article class="insight-card">
            <span class="insight-meta">{article.category} · {article.readTime}</span>
            <h3>{article.title}</h3>
            <p>{article.description}</p>
            <a class="text-link" href={`/insights/${article.slug}/`}>Read article <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="page-width cta-inner">
      <div>
        <p class="eyebrow">Start a conversation</p>
        <h2>What does your organization need technology to do better?</h2>
        <p>Tell us the outcome. We’ll help you explore the right software, systems and next steps.</p>
      </div>
      <div class="cta-actions">
        <a class="button button-light" href="/contact/">Talk to Overdott <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .capability-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .capability-card {
    position: relative;
    display: flex;
    min-height: 280px;
    overflow: hidden;
    padding: 30px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    flex-direction: column;
    background: #fff;
    transition: border-color 200ms ease, box-shadow 200ms ease, transform 200ms ease;
  }

  .capability-card:first-child {
    color: #fff;
    border-color: var(--navy);
    background:
      radial-gradient(circle at 88% 12%, rgba(38, 117, 232, 0.26), transparent 38%),
      var(--navy);
  }

  .capability-card:first-child::after {
    position: absolute;
    right: -90px;
    bottom: -120px;
    width: 280px;
    height: 280px;
    border: 1px solid rgba(138, 184, 255, 0.13);
    border-radius: 50%;
    content: '';
  }

  .capability-top {
    display: flex;
    margin-bottom: 30px;
    align-items: center;
    justify-content: space-between;
  }

  .capability-icon {
    display: grid;
    width: 42px;
    height: 42px;
    border-radius: 11px;
    place-items: center;
    color: var(--blue);
    background: var(--mist-blue);
  }

  .capability-card:first-child .capability-icon {
    color: #a8caff;
    background: rgba(138, 184, 255, 0.12);
  }

  .capability-icon svg {
    width: 22px;
    height: 22px;
  }

  .capability-number {
    color: #8b99ac;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .capability-card:first-child .capability-number {
    color: #7f96b3;
  }

  .capability-card h3 {
    margin-bottom: 12px;
    font-size: 1.45rem;
  }

  .capability-card:first-child h3 {
    color: #fff;
  }

  .capability-card p {
    max-width: 470px;
    margin-bottom: 25px;
    font-size: 14px;
  }

  .capability-card:first-child p {
    color: #b7c6d9;
  }

  .capability-link {
    display: inline-flex;
    margin-top: auto;
    align-items: center;
    gap: 9px;
    color: var(--blue-dark);
    font-size: 13px;
    font-weight: 700;
  }

  .capability-card:first-child .capability-link {
    color: #a8caff;
  }

  .capability-link span {
    transition: transform 180ms ease;
  }

  .product-spotlight {
    display: grid;
    padding: clamp(34px, 5vw, 64px);
    border: 1px solid #dce6f4;
    border-radius: 24px;
    grid-template-columns: minmax(0, 0.95fr) minmax(380px, 1.05fr);
    align-items: center;
    gap: clamp(38px, 6vw, 76px);
    background: #eaf1fb;
  }

  .product-spotlight-copy h2 {
    margin-bottom: 20px;
    font-size: clamp(2rem, 3.4vw, 3rem);
  }

  .product-spotlight-copy > p:not(.eyebrow) {
    font-size: 16px;
  }

  .product-spotlight-copy .check-list {
    margin-block: 22px 28px;
  }

  .product-spotlight-copy .check-list li {
    font-size: 14px;
  }

  .product-ui {
    position: relative;
    overflow: hidden;
    border: 1px solid #d5deeb;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 28px 65px rgba(14, 42, 79, 0.16);
    transform: rotate(1.5deg);
  }

  .product-ui-bar {
    display: flex;
    min-height: 54px;
    padding: 12px 17px;
    border-bottom: 1px solid #e7ecf3;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .product-ui-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--navy);
    font-family: var(--heading);
    font-size: 15px;
    letter-spacing: -0.04em;
  }

  .product-ui-status {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #7a889b;
    font-size: 9px;
  }

  .product-ui-status i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #2baf76;
  }

  .product-ui-body {
    padding: 25px;
  }

  .product-ui-heading {
    display: grid;
    margin-bottom: 21px;
    gap: 6px;
  }

  .product-ui-heading span {
    color: #8694a8;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .product-ui-heading strong {
    color: var(--ink);
    font-family: var(--heading);
    font-size: 18px;
    letter-spacing: -0.04em;
    line-height: 1.3;
  }

  .product-ui-modules {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 9px;
  }

  .product-ui-modules > div {
    display: grid;
    min-height: 105px;
    padding: 12px;
    border: 1px solid #e4eaf2;
    border-radius: 10px;
    align-content: end;
    gap: 3px;
    background: #fbfcfe;
  }

  .module-symbol {
    display: grid;
    width: 26px;
    height: 26px;
    margin-bottom: 9px;
    border-radius: 7px;
    place-items: center;
    font-size: 10px;
    font-style: normal;
    font-weight: 700;
  }

  .module-blue {
    color: #2675e8;
    background: #e9f1ff;
  }

  .module-green {
    color: #218553;
    background: #e9f7f0;
  }

  .module-violet {
    color: #7656c8;
    background: #f1edfd;
  }

  .product-ui-modules small {
    color: #7b889a;
    font-size: 8px;
  }

  .product-ui-modules b {
    color: #26364d;
    font-size: 9px;
  }

  .product-ui-panel {
    margin-top: 14px;
    padding: 16px;
    border: 1px solid #e4eaf2;
    border-radius: 10px;
  }

  .product-ui-panel-head {
    display: flex;
    margin-bottom: 10px;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .product-ui-panel-head strong {
    color: #2a3a50;
    font-size: 10px;
  }

  .product-ui-panel-head span {
    color: var(--blue);
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .module-row {
    display: flex;
    padding: 9px 0;
    border-top: 1px solid #edf1f6;
    align-items: center;
    justify-content: space-between;
    color: #627187;
    font-size: 9px;
  }

  .module-row i {
    width: 7px;
    height: 7px;
    border: 2px solid #2675e8;
    border-radius: 50%;
  }

  .product-ui-caption {
    display: block;
    padding: 9px 17px;
    border-top: 1px solid #e7ecf3;
    color: #94a0b0;
    background: #fbfcfe;
    font-size: 8px;
    text-align: center;
  }

  @media (hover: hover) {
    .capability-card:hover {
      border-color: #b7cdf0;
      box-shadow: var(--shadow-sm);
      transform: translateY(-4px);
    }

    .capability-card:first-child:hover {
      border-color: #234b7f;
    }

    .capability-card:hover .capability-link span {
      transform: translate(2px, -1px);
    }
  }

  @media (max-width: 980px) {
    .product-spotlight {
      grid-template-columns: 1fr;
    }

    .product-spotlight-copy {
      max-width: 700px;
    }

    .product-ui {
      width: min(100%, 600px);
      margin-inline: auto;
      transform: none;
    }
  }

  @media (max-width: 600px) {
    .capability-grid {
      grid-template-columns: 1fr;
    }

    .capability-card {
      min-height: 0;
      padding: 25px;
    }

    .product-spotlight {
      border-radius: 18px;
    }

    .product-ui-body {
      padding: 18px;
    }

    .product-ui-status {
      display: none;
    }

    .product-ui-heading strong {
      font-size: 16px;
    }

    .product-ui-modules {
      gap: 6px;
    }

    .product-ui-modules > div {
      min-height: 96px;
      padding: 9px;
    }
  }
</style>
