---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { whatsappDisplay, whatsappNumber } from '../../config';

const categories = [
  ['Servers, storage and networking', 'Hardware enquiries for infrastructure needs, with compatibility and deployment considerations.'],
  ['Cybersecurity software', 'Enquiries about endpoint, identity, email and network security options.'],
  ['Endpoint and IT management', 'Tools for device management, patching, monitoring and IT asset visibility.'],
  ['Cloud and productivity software', 'Cloud infrastructure, collaboration and productivity licensing enquiries.'],
  ['Backup and disaster recovery', 'Options for data protection, recovery planning and business continuity.'],
  ['Business software and ERP', 'Business application enquiries subject to confirmed product availability and scope.'],
];

const resolveAppUrl = (value: string | undefined) => {
  const trimmed = value?.trim();
  if (!trimmed) return null;

  try {
    const url = new URL(trimmed);
    return ['http:', 'https:'].includes(url.protocol) ? url : null;
  } catch {
    return null;
  }
};
const velldotAppUrl =
  resolveAppUrl(import.meta.env.PUBLIC_VELLDOT_URL) ??
  resolveAppUrl(import.meta.env.PUBLIC_SORA_URL);
const velldotPricingUrl = velldotAppUrl
  ? new URL('/pricing', velldotAppUrl).toString()
  : '/contact/?interest=velldot-purchase#enquiry';
---

<BaseLayout title="Software Products & Technology Sourcing | Overdott" description="Explore Velldot ERP and enquire about hardware, software, cloud, cybersecurity and business application options from Overdott.">
  <section class="page-hero page-hero-split">
    <div class="page-width page-hero-inner">
      <div class="page-hero-copy">
        <p class="eyebrow">Products and technology sourcing</p>
        <h1>Find technology that fits your requirements.</h1>
        <p>Explore our own business software or tell us what you need to source, license and implement.</p>
      </div>
      <aside class="page-hero-aside" aria-label="Product areas">
        <div class="hero-panel">
          <p class="hero-panel-label">What we can help with</p>
          <div class="hero-panel-grid">
            <div class="hero-panel-item"><small>Owned product</small><strong>Velldot ERP</strong></div>
            <div class="hero-panel-item"><small>Software</small><strong>Licensing</strong></div>
            <div class="hero-panel-item"><small>Infrastructure</small><strong>Hardware</strong></div>
            <div class="hero-panel-item"><small>Security</small><strong>Controls</strong></div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section page-width">
    <div class="product-directory-feature">
      <div class="product-directory-copy">
        <img src="/velldot-wordmark.svg" alt="Velldot ERP" width="190" height="44" />
        <p class="eyebrow">Business software by Overdott</p>
        <h2>One workspace for the way your organization works.</h2>
        <p>Velldot ERP connects projects, finance, procurement, sales, people, inventory and service operations through licensed modules and separate organization workspaces.</p>
        <ul class="check-list">
          <li>Start with a no-card trial</li>
          <li>Scale with the modules your team needs</li>
          <li>Purchase and renewal options include M-Pesa when configured</li>
        </ul>
        <div class="hero-actions">
          <a class="button" href="/velldot/">Explore Velldot ERP <span aria-hidden="true">→</span></a>
          <a class="button button-outline-dark" href={velldotPricingUrl}>{velldotAppUrl ? 'View pricing & purchase' : 'Ask about purchasing'} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="product-directory-visual" aria-hidden="true">
        <div class="directory-orbit orbit-a"></div>
        <div class="directory-orbit orbit-b"></div>
        <div class="directory-mark"><img src="/velldot-mark.svg" alt="" width="86" height="86" /></div>
        <span class="directory-pill pill-one">Projects</span>
        <span class="directory-pill pill-two">Finance</span>
        <span class="directory-pill pill-three">People</span>
        <span class="directory-pill pill-four">Operations</span>
      </div>
    </div>
  </section>

  <section class="section section-tint" id="categories">
    <div class="page-width">
      <div class="section-heading">
        <p class="eyebrow">Technology categories</p>
        <h2>Start with what the organization needs to do.</h2>
        <p>This is an enquiry directory, not a general online store. Availability, pricing, licensing and sourcing arrangements are confirmed individually.</p>
      </div>
      <div class="directory-grid">
        {categories.map(([title, description]) => (
          <article class="directory-item"><h3>{title}</h3><p>{description}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="page-width cta-inner">
      <div>
        <p class="eyebrow">Product enquiry</p>
        <h2>Looking for a specific product or licence?</h2>
        <p>Share the use case, compatibility requirements and quantity you have in mind.</p>
      </div>
      <div class="cta-actions">
        <a class="button button-light" href="/contact/">Make a product enquiry <span aria-hidden="true">↗</span></a>
        <a class="button button-light" href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer">WhatsApp {whatsappDisplay} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .product-directory-feature {
    display: grid;
    overflow: hidden;
    border: 1px solid #dce6f4;
    border-radius: 22px;
    grid-template-columns: minmax(0, 1.1fr) minmax(340px, 0.9fr);
    background: #edf4ff;
  }

  .product-directory-copy {
    padding: clamp(28px, 4vw, 48px);
  }

  .product-directory-copy > img {
    width: 174px;
    margin-bottom: 26px;
  }

  .product-directory-copy h2 {
    margin-bottom: 19px;
  }

  .product-directory-copy > p:not(.eyebrow) {
    font-size: 16px;
  }

  .product-directory-copy .check-list li {
    font-size: 14px;
  }

  .product-directory-visual {
    position: relative;
    min-height: 420px;
    overflow: hidden;
    background:
      radial-gradient(circle at center, rgba(38, 117, 232, 0.2), transparent 45%),
      #0a1d38;
  }

  .product-directory-visual::before {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 48px 48px;
    content: '';
    mask-image: radial-gradient(circle, #000, transparent 72%);
  }

  .directory-orbit {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 76%;
    height: 48%;
    border: 1px solid rgba(138, 184, 255, 0.25);
    border-radius: 50%;
    transform: translate(-50%, -50%) rotate(-20deg);
  }

  .orbit-b {
    width: 54%;
    height: 76%;
    border-color: rgba(138, 184, 255, 0.14);
    transform: translate(-50%, -50%) rotate(35deg);
  }

  .directory-mark {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 148px;
    height: 148px;
    border: 1px solid rgba(158, 197, 255, 0.32);
    border-radius: 34px;
    place-items: center;
    background: linear-gradient(145deg, #1c467b, #0c2342);
    box-shadow: 0 28px 60px rgba(0, 0, 0, 0.32);
    transform: translate(-50%, -50%) rotate(-6deg);
  }

  .directory-mark img {
    transform: rotate(6deg);
  }

  .directory-pill {
    position: absolute;
    padding: 9px 14px;
    border: 1px solid rgba(170, 204, 255, 0.2);
    border-radius: 999px;
    color: #dce9fb;
    background: rgba(12, 34, 62, 0.94);
    font-size: 11px;
    font-weight: 600;
    box-shadow: 0 12px 26px rgba(0, 0, 0, 0.2);
  }

  .pill-one { top: 16%; left: 9%; }
  .pill-two { top: 21%; right: 7%; }
  .pill-three { bottom: 18%; left: 5%; }
  .pill-four { right: 8%; bottom: 14%; }

  @media (max-width: 900px) {
    .product-directory-feature {
      grid-template-columns: 1fr;
    }

    .product-directory-visual {
      min-height: 340px;
    }
  }

  @media (max-width: 560px) {
    .product-directory-copy {
      padding: 28px 24px;
    }

    .product-directory-visual {
      min-height: 300px;
    }

    .directory-mark {
      width: 122px;
      height: 122px;
      border-radius: 28px;
    }

    .directory-mark img {
      width: 70px;
      height: 70px;
    }
  }
</style>
