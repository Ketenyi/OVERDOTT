---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { whatsappDisplay, whatsappNumber } from '../../config';

const categories = [
  ['Servers, storage and networking', 'Infrastructure enquiries with compatibility, deployment and support considerations.'],
  ['Cybersecurity software', 'Requirements for endpoint, identity, email and network security options.'],
  ['Endpoint and IT management', 'Tools for device management, patching, monitoring and IT asset visibility.'],
  ['Cloud and productivity software', 'Cloud infrastructure, collaboration and productivity licensing enquiries.'],
  ['Backup and disaster recovery', 'Options for data protection, recovery planning and business continuity.'],
  ['Business software and ERP', 'Business application options alongside the Velldot product initiative, subject to confirmed scope and availability.'],
];

const velldotProducts = [
  ['01', 'Velldot ERP', 'Verified build', 'Integrated business management'],
  ['02', 'Velldot HR', 'In development', 'Employee information and HR processes'],
  ['03', 'Velldot Projects', 'In development', 'Projects, tasks and responsibilities'],
];
---

<BaseLayout title="Software Products & Technology Sourcing | Overdott" description="Explore the Velldot product initiative and enquire about software, cloud, cybersecurity and infrastructure requirements from Overdott.">
  <section class="page-hero page-hero-split">
    <div class="page-width page-hero-inner">
      <div class="page-hero-copy">
        <p class="eyebrow">Products and technology sourcing</p>
        <h1>Find technology that fits your requirements.</h1>
        <p>Explore our own product initiative or tell us what you need to source, license and implement around your business.</p>
      </div>
      <aside class="page-hero-aside" aria-label="Product areas">
        <div class="hero-panel">
          <p class="hero-panel-label">What we can help with</p>
          <div class="hero-panel-grid">
            <div class="hero-panel-item"><small>Product initiative</small><strong>Velldot</strong></div>
            <div class="hero-panel-item"><small>Software</small><strong>Licensing</strong></div>
            <div class="hero-panel-item"><small>Infrastructure</small><strong>Hardware</strong></div>
            <div class="hero-panel-item"><small>Security</small><strong>Controls</strong></div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section page-width">
    <div class="product-directory-feature">
      <div class="product-directory-copy">
        <img src="/velldot-wordmark.svg" alt="Velldot" width="190" height="44" />
        <p class="eyebrow">A product initiative by Overdott</p>
        <h2>Business software designed around the way businesses work.</h2>
        <p>Velldot ERP brings verified modules for projects, finance, procurement, sales, HR, inventory and service operations into an integrated business management platform. HR and Projects are also being developed as standalone product initiatives.</p>
        <ul class="check-list">
          <li>Review verified ERP capabilities and limitations</li>
          <li>Register interest for early access or a product discussion</li>
          <li>Confirm deployment, licensing and support requirements by enquiry</li>
        </ul>
        <div class="hero-actions">
          <a class="button" href="/velldot/">Explore Velldot <span aria-hidden="true">→</span></a>
          <a class="button button-outline-dark" href="/contact/?interest=velldot-deployment#enquiry">Discuss deployment &amp; licensing <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="product-directory-visual" role="img" aria-label="Velldot product family: ERP with a verified build, and HR and Projects in development.">
        <div class="directory-head">
          <img src="/velldot-mark.svg" alt="" width="34" height="34" />
          <div><strong>Velldot</strong><span>Product family / By Overdott</span></div>
        </div>
        <div class="directory-product-list">
          {velldotProducts.map(([number, name, status, detail]) => (
            <div>
              <span>{number}</span>
              <div><strong>{name}</strong><small>{detail}</small></div>
              <em>{status}</em>
            </div>
          ))}
        </div>
        <div class="directory-foot">
          <span>10 verified ERP modules</span>
          <span>Availability confirmed by enquiry</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-tint" id="categories">
    <div class="page-width">
      <div class="section-heading">
        <p class="eyebrow">Technology categories</p>
        <h2>Start with what the organization needs to do.</h2>
        <p>This is an enquiry directory, not a general online store. Availability, pricing, licensing and sourcing arrangements are confirmed individually for each requirement.</p>
      </div>
      <div class="directory-grid">
        {categories.map(([title, description], index) => (
          <article class="directory-item">
            <span class="directory-number">{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="page-width cta-inner">
      <div>
        <p class="eyebrow">Product enquiry</p>
        <h2>Looking for a specific product or licence?</h2>
        <p>Share the use case, compatibility requirements and quantity you have in mind.</p>
      </div>
      <div class="cta-actions">
        <a class="button button-light" href="/contact/">Make a product enquiry <span aria-hidden="true">↗</span></a>
        <a class="button button-outline" href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer">WhatsApp {whatsappDisplay} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .product-directory-feature {
    display: grid;
    overflow: hidden;
    border: 1px solid #d9ddd9;
    border-radius: 4px;
    grid-template-columns: minmax(0, 1.1fr) minmax(340px, 0.9fr);
    background: var(--paper);
  }

  .product-directory-copy {
    padding: clamp(28px, 4vw, 48px);
  }

  .product-directory-copy > img {
    width: 174px;
    margin-bottom: 26px;
  }

  .product-directory-copy h2 {
    margin-bottom: 19px;
  }

  .product-directory-copy > p:not(.eyebrow) {
    font-size: 16px;
  }

  .product-directory-copy .check-list li {
    font-size: 14px;
  }

  .product-directory-visual {
    display: flex;
    min-width: 0;
    min-height: 420px;
    padding: 30px;
    flex-direction: column;
    color: #fff;
    background: var(--navy);
  }

  .directory-head {
    display: flex;
    padding-bottom: 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    align-items: center;
    gap: 13px;
  }

  .directory-head img {
    padding: 6px;
    background: #fff;
  }

  .directory-head > div {
    display: grid;
    gap: 2px;
  }

  .directory-head strong {
    font-family: var(--heading);
    font-size: 1.15rem;
    letter-spacing: -0.03em;
  }

  .directory-head span {
    color: #8fa5bf;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .directory-product-list {
    display: grid;
  }

  .directory-product-list > div {
    display: grid;
    min-height: 91px;
    padding: 17px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    grid-template-columns: 27px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
  }

  .directory-product-list > div > span {
    color: #79a9e8;
    font-size: 9px;
    font-weight: 700;
  }

  .directory-product-list > div > div {
    display: grid;
    gap: 4px;
  }

  .directory-product-list strong {
    color: #fff;
    font-family: var(--heading);
    font-size: 13px;
  }

  .directory-product-list small {
    color: #8fa5bf;
    font-size: 9px;
    line-height: 1.5;
  }

  .directory-product-list em {
    color: #a9c9ee;
    font-size: 8px;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: right;
    text-transform: uppercase;
  }

  .directory-foot {
    display: flex;
    padding-top: 21px;
    margin-top: auto;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    color: #8097b2;
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .directory-number {
    display: block;
    margin-bottom: 22px;
    color: var(--blue);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  @media (max-width: 900px) {
    .product-directory-feature {
      grid-template-columns: 1fr;
    }

    .product-directory-visual {
      min-height: 360px;
    }
  }

  @media (max-width: 560px) {
    .product-directory-copy {
      padding: 28px 24px;
    }

    .product-directory-visual {
      min-height: 330px;
      padding: 23px;
    }

    .directory-product-list > div {
      grid-template-columns: 24px minmax(0, 1fr);
    }

    .directory-product-list em {
      grid-column: 2;
      text-align: left;
    }

    .directory-foot {
      align-items: flex-start;
      flex-direction: column;
      gap: 5px;
    }
  }
</style>
