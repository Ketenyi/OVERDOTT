---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services, findService, findPillar, type Service } from '../../data/services';
import { whatsappDisplay, whatsappNumber } from '../../config';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const pillar = findPillar(service.pillar)!;
const relatedServices = service.related
  .map(findService)
  .filter((item): item is Service => item !== undefined);
const serviceNumber = String(
  services.findIndex((item) => item.slug === service.slug) + 1,
).padStart(2, '0');
const whatsappUrl = `https://wa.me/${whatsappNumber}`;
const enquiryUrl = `/contact/?interest=${service.slug}`;
---

<BaseLayout
  title={`${service.title} | Overdott Technologies`}
  description={service.summary}
  image={service.image}
>
  <section class="page-hero page-hero-split service-hero">
    <div class="page-width page-hero-inner">
      <div class="page-hero-copy">
        <p class="eyebrow">{service.category} · Kenya</p>
        <h1>{service.title}</h1>
        <p>{service.summary}</p>
        <div class="hero-actions">
          <a class="button" href={enquiryUrl}>{service.cta} <span aria-hidden="true">↗</span></a>
          <a class="button button-outline" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Chat on WhatsApp <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <aside class="page-hero-aside" aria-label="Service focus">
        <div class="hero-panel service-focus-panel">
          <div class="service-focus-heading">
            <span>{serviceNumber}</span>
            <p class="hero-panel-label">Engagement focus</p>
          </div>
          <div class="capability-chips">
            {service.capabilities.slice(0, 4).map((capability) => (
              <span>{capability}</span>
            ))}
          </div>
          <div class="hero-panel-footer">
            <span>Service area</span>
            <strong>{service.category}</strong>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section-compact page-width service-need">
    <div class="section-heading">
      <p class="eyebrow">The business need</p>
      <h2>Start with what’s getting in the way.</h2>
      <p>Technology should support the work your organization needs to do. A focused conversation establishes priorities before options are proposed.</p>
    </div>
    <div class="need-card">
      <p class="need-card-label">Common starting points</p>
      <ul class="bullet-list">
        {service.problems.map((problem) => <li>{problem}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section-tint">
    <div class="page-width">
      <div class="section-heading">
        <p class="eyebrow">Capabilities</p>
        <h2>{service.title}, scoped around your needs.</h2>
        <p>Specific technologies, product availability and delivery arrangements are confirmed after understanding your requirements.</p>
      </div>
      <div class="capability-grid">
        <article class="capability-card">
          <span class="capability-number">01</span>
          <h3>Areas we can discuss</h3>
          <ul class="bullet-list">
            {service.capabilities.map((capability) => <li>{capability}</li>)}
          </ul>
        </article>
        <article class="capability-card capability-card-accent">
          <span class="capability-number">02</span>
          <h3>{pillar.startingPointsLabel}</h3>
          <ul class="check-list">
            {pillar.startingPoints.map((item) => <li>{item}</li>)}
          </ul>
          <p class="capability-card-note">Final scope, assumptions, technologies and deliverables are agreed before implementation.</p>
        </article>
      </div>
      {(service.technologies || pillar.technologies) && (
        <div class="technology-note service-technology-note">
          <strong>Relevant technologies may include</strong>
          <span>{(service.technologies || pillar.technologies)!.join(' · ')}</span>
          <small>No vendor partnership or authorization is claimed. Delivery depends on the agreed scope and appropriately qualified resources.</small>
        </div>
      )}
    </div>
  </section>

  <section class="section section-compact page-width">
    <div class="section-heading">
      <p class="eyebrow">A straightforward process</p>
      <h2>Agree on the work before it begins.</h2>
    </div>
    <div class="process-grid">
      <div class="process-step">
        <h3>Understand</h3>
        <p>Review the requirement, context, environment and stakeholders.</p>
      </div>
      <div class="process-step">
        <h3>Design</h3>
        <p>Compare options, dependencies and project scope.</p>
      </div>
      <div class="process-step">
        <h3>Implement</h3>
        <p>Complete agreed sourcing, configuration, integration and testing.</p>
      </div>
      <div class="process-step">
        <h3>Support</h3>
        <p>Document handover and consider support arrangements.</p>
      </div>
    </div>
  </section>

  <section class="section section-compact page-width service-support-layout">
    <div>
      <div class="section-heading">
        <p class="eyebrow">Frequently asked questions</p>
        <h2>Before we get started.</h2>
      </div>
      <div class="faq-list">
        {service.faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
    <aside class="related-panel">
      <p class="eyebrow">Related services</p>
      <h2>Bring the right pieces together.</h2>
      <p>Explore connected capabilities or discuss the wider requirement with Overdott.</p>
      <div class="related-links">
        {relatedServices.map((related) => (
          <a href={`/services/${related.slug}/`}>{related.title} <span aria-hidden="true">→</span></a>
        ))}
      </div>
      <a class="text-link" href={whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp {whatsappDisplay} <span aria-hidden="true">↗</span></a>
    </aside>
  </section>

  <section class="cta-band">
    <div class="page-width cta-inner">
      <div>
        <p class="eyebrow">Start a conversation</p>
        <h2>Talk to us about {service.title.toLowerCase()}.</h2>
        <p>Share your goals and current setup. We’ll help identify a sensible next step.</p>
      </div>
      <div class="cta-actions">
        <a class="button button-light" href={enquiryUrl}>{service.cta} <span aria-hidden="true">↗</span></a>
        <a class="button button-outline" href={whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp us <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
