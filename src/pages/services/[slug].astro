---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services, findService } from '../../data/services';
export function getStaticPaths() { return services.map((service) => ({ params: { slug: service.slug }, props: { service } })); }
const { service } = Astro.props;
const relatedServices = service.related.map(findService).filter((item) => item !== undefined);
---
<BaseLayout title={`${service.title} | Overdott Technologies`} description={service.summary} image={service.image}>
  <section class="page-hero" style={`--page-image:url('${service.image}')`}><div class="page-width page-hero-inner"><p class="eyebrow">{service.category} · Kenya</p><h1>{service.title}</h1><p>{service.summary}</p><div class="hero-actions" style="margin-top:26px"><a class="button" href="/contact/">Discuss your requirements <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="section page-width"><div class="split-list"><div class="list-block"><p class="eyebrow">The business need</p><h2>Start with what's getting in the way.</h2><p>Technology should support the work your organization needs to do. A focused conversation can help establish priorities.</p></div><ul class="bullet-list">{service.problems.map((item)=><li>{item}</li>)}</ul></div></section>
  <section class="section section-tint"><div class="page-width"><div class="section-heading"><p class="eyebrow">Capabilities</p><h2>{service.title}, scoped around your needs.</h2><p>Specific technologies, product availability and delivery arrangements are confirmed after understanding your requirements.</p></div><div class="split-list"><div class="list-block"><h3>Areas we can discuss</h3><ul class="bullet-list">{service.capabilities.map((item)=><li>{item}</li>)}</ul></div><div class="list-block"><h3>Potential engagement deliverables</h3><ul class="bullet-list"><li>Requirements and current-environment review</li><li>Suitable options, assumptions and agreed project scope</li><li>Implementation, testing and handover as specified</li></ul></div></div></div></section>
  <section class="section page-width"><div class="section-heading"><p class="eyebrow">A straightforward process</p><h2>Agree on the work before it begins.</h2></div><div class="process-grid"><div class="process-step"><h3>Understand</h3><p>Review the requirement, context, environment and stakeholders.</p></div><div class="process-step"><h3>Design</h3><p>Compare options, dependencies and project scope.</p></div><div class="process-step"><h3>Implement</h3><p>Complete agreed sourcing, configuration, integration and testing.</p></div><div class="process-step"><h3>Support</h3><p>Document handover and consider support arrangements.</p></div></div></section>
  <section class="section section-tint"><div class="page-width"><div class="section-heading"><p class="eyebrow">Frequently asked questions</p><h2>Before we get started.</h2></div><div class="faq-list">{service.faqs.map((faq)=><details class="faq-item"><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></div></section>
  <section class="section page-width"><div class="section-heading"><p class="eyebrow">Related services</p><h2>Bring the right pieces together.</h2></div><div class="related-links">{relatedServices.map((related)=><a href={`/services/${related.slug}/`}>{related.title} →</a>)}</div></section>
  <section class="cta-band"><div class="page-width cta-inner"><div><h2>Talk to us about {service.title.toLowerCase()}.</h2><p>Share your goals and current setup. We'll help identify a sensible next step.</p></div><div class="cta-actions"><a class="button button-light" href="/contact/">Request a consultation <span aria-hidden="true">↗</span></a></div></div></section>
</BaseLayout>