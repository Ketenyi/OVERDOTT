---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { digitalServices, servicePillars } from '../../data/services';
import { whatsappNumber } from '../../config';

const pillar = servicePillars.find((item) => item.id === 'digital')!;
const whatsappUrl = `https://wa.me/${whatsappNumber}`;
const serviceMarks: Record<string, string> = {
  'website-development': 'WD',
  'software-development': 'SD',
  'digital-marketing': 'DM',
};
---

<BaseLayout
  title="Digital Solutions & Development | Websites & Web Apps | Overdott"
  description="Explore business websites, e-commerce, landing pages, custom web applications, website modernization, maintenance and integrations from Overdott."
>
  <section class="page-hero page-hero-split">
    <div class="page-width page-hero-inner">
      <div class="page-hero-copy">
        <p class="eyebrow">Service 01 · Digital Solutions &amp; Development</p>
        <h1>Build your digital presence. Create better experiences.</h1>
        <p>{pillar.description}</p>
        <div class="hero-actions">
          <a class="button" href="/contact/?interest=digital-development">{pillar.cta} <span aria-hidden="true">↗</span></a>
          <a class="button button-outline" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Chat on WhatsApp <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <aside class="page-hero-aside" aria-label="Digital business outcomes">
        <div class="hero-panel">
          <p class="hero-panel-label">What digital solutions can enable</p>
          <ul class="check-list hero-panel-checks">
            {pillar.outcomes.slice(0, 4).map((outcome) => <li>{outcome}</li>)}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="section page-width">
    <div class="section-heading">
      <p class="eyebrow">From first impression to useful interaction</p>
      <h2>Digital platforms built around real business needs.</h2>
      <p>Each engagement starts with the audience, the desired action and the systems involved. Scope, content, functionality and ownership are agreed before development.</p>
    </div>
    <div class="service-offering-grid">
      {pillar.services.map((service, index) => (
        <article class="service-offering">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{service.title}</h3>
          <p>{service.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-tint">
    <div class="page-width">
      <div class="section-topline">
        <div class="section-heading">
          <p class="eyebrow">Ways to start</p>
          <h2>A clear package, shaped to the requirement.</h2>
          <p>Package names provide a starting point. Final pages, functionality, content, integrations and support are defined in the agreed scope.</p>
        </div>
      </div>
      <div class="package-card-grid">
        {pillar.startingPoints.map((item, index) => (
          <article class="package-card">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{item}</h3>
            <p>Discuss your goals, audience, current setup and desired outcomes to define the right deliverables.</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-compact page-width">
    <div class="section-topline">
      <div class="section-heading">
        <p class="eyebrow">Explore a capability</p>
        <h2>Start with the part of your digital presence that needs attention.</h2>
      </div>
      <a class="text-link" href="/services/">See all services <span aria-hidden="true">→</span></a>
    </div>
    <div class="card-grid">
      {digitalServices.map((service) => (
        <article class="service-card">
          <div class="service-card-top">
            <span class="service-card-mark" aria-hidden="true">{serviceMarks[service.slug]}</span>
            <span class="service-index">{service.category}</span>
          </div>
          <h3>{service.title}</h3>
          <p>{service.summary}</p>
          <a class="text-link" href={`/services/${service.slug}/`}>{service.cta} <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-compact section-tint">
    <div class="page-width image-copy">
      <div>
        <p class="eyebrow">Part of the bigger picture</p>
        <h2>Connect your digital presence to the systems behind it.</h2>
        <p>A website, online store or web application can depend on hosting, security, data and ongoing technical support. We can discuss those needs together and make dependencies clear.</p>
        <ul class="check-list">
          <li>Clear project objectives and requirements</li>
          <li>Consideration of existing tools and integrations</li>
          <li>Accessibility and mobile usability in the plan</li>
          <li>Handover and maintenance options where agreed</li>
        </ul>
        <a class="text-link" href="/solutions/">Explore technology solutions <span aria-hidden="true">→</span></a>
      </div>
      <div class="digital-visual" aria-hidden="true">
        <div class="digital-window">
          <div class="digital-window-bar">
            <span class="digital-window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <strong>Overdott / Digital stack</strong>
            <small>Connected by design</small>
          </div>
          <div class="digital-window-body">
            <div class="digital-layer">
              <small>01 / EXPERIENCE</small>
              <strong>Experience</strong>
              <span>Clear content · Responsive access</span>
            </div>
            <div class="digital-layer">
              <small>02 / WORKFLOW</small>
              <strong>Workflow</strong>
              <span>Business tools · Integrations</span>
            </div>
            <div class="digital-layer">
              <small>03 / FOUNDATION</small>
              <strong>Foundation</strong>
              <span>Hosting · Security · Data</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="page-width cta-inner">
      <div>
        <p class="eyebrow">Start a conversation</p>
        <h2>Have a digital project in mind?</h2>
        <p>Tell us what you want customers or your team to be able to do.</p>
      </div>
      <div class="cta-actions">
        <a class="button button-light" href="/contact/?interest=digital-development">{pillar.cta} <span aria-hidden="true">↗</span></a>
        <a class="button button-outline" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Chat on WhatsApp <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
