---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { digitalServices } from '../../data/services';
import { whatsappNumber } from '../../config';

const whatsappUrl = `https://wa.me/${whatsappNumber}`;

const digitalAreas = [
  { label: 'Websites', detail: 'Design & development' },
  { label: 'Business software', detail: 'Applications & workflows' },
  { label: 'Digital marketing', detail: 'Search & online presence' },
  { label: 'Technology alignment', detail: 'Systems & support' },
];

const serviceMarks: Record<string, string> = {
  'website-development': 'WD',
  'software-development': 'SD',
  'digital-marketing': 'DM',
};
---

<BaseLayout title="Digital Services | Websites, Software & Marketing | Overdott" description="Explore website development, custom software, business applications and digital marketing enquiries from Overdott Technologies in Kenya.">
  <section class="page-hero page-hero-split">
    <div class="page-width page-hero-inner">
      <div class="page-hero-copy">
        <p class="eyebrow">Web development · Software · Digital</p>
        <h1>Websites and digital tools, built around real work.</h1>
        <p>Build a credible corporate website, a focused web application or a clearer online presence—with the systems behind it considered from the start.</p>
        <div class="hero-actions">
          <a class="button" href="/contact/?interest=website-development">Discuss a website project <span aria-hidden="true">↗</span></a>
          <a class="button button-outline" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Chat on WhatsApp <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <aside class="page-hero-aside" aria-label="Digital delivery areas">
        <div class="hero-panel">
          <p class="hero-panel-label">A connected digital picture</p>
          <div class="hero-panel-grid">
            {digitalAreas.map((area) => (
              <div class="hero-panel-item">
                <small>{area.detail}</small>
                <strong>{area.label}</strong>
              </div>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section page-width">
    <div class="section-heading">
      <p class="eyebrow">From online presence to business workflows</p>
      <h2>Digital services with a practical foundation.</h2>
      <p>Every service is available to enquire about. A requirements conversation establishes deliverables, scope and delivery approach.</p>
    </div>
    <div class="card-grid">
      {digitalServices.map((service, index) => (
        <article class="service-card">
          <div class="service-card-top">
            <span class="service-card-mark" aria-hidden="true">{serviceMarks[service.slug]}</span>
            <span class="service-index">0{index + 1} / DIGITAL</span>
          </div>
          <h3>{service.title}</h3>
          <p>{service.summary}</p>
          <a class="text-link" href={`/services/${service.slug}/`}>Explore this service <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-compact section-tint">
    <div class="page-width image-copy">
      <div>
        <p class="eyebrow">Part of the bigger picture</p>
        <h2>Connect your digital presence to the systems behind it.</h2>
        <p>A website, workflow or marketing initiative can depend on hosting, security, data and ongoing technical support. We can discuss those needs together and make dependencies clear.</p>
        <ul class="check-list">
          <li>Clear project objectives and requirements</li>
          <li>Consideration of existing tools and integrations</li>
          <li>Accessibility and mobile usability in the plan</li>
          <li>Handover and maintenance options where agreed</li>
        </ul>
        <a class="text-link" href="/solutions/">Explore technology solutions <span aria-hidden="true">→</span></a>
      </div>
      <div class="digital-visual" aria-hidden="true">
        <div class="digital-window">
          <div class="digital-window-bar">
            <span class="digital-window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <strong>Overdott / Digital stack</strong>
            <small>Connected by design</small>
          </div>
          <div class="digital-window-body">
            <div class="digital-layer">
              <small>01 / EXPERIENCE</small>
              <strong>Experience</strong>
              <span>Clear content · Responsive access</span>
            </div>
            <div class="digital-layer">
              <small>02 / WORKFLOW</small>
              <strong>Workflow</strong>
              <span>Business tools · Integrations</span>
            </div>
            <div class="digital-layer">
              <small>03 / FOUNDATION</small>
              <strong>Foundation</strong>
              <span>Hosting · Security · Data</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="page-width cta-inner">
      <div>
        <p class="eyebrow">Start a conversation</p>
        <h2>Have a digital project in mind?</h2>
        <p>Tell us what you want people or your team to be able to do.</p>
      </div>
      <div class="cta-actions">
        <a class="button button-light" href="/contact/">Discuss your project <span aria-hidden="true">↗</span></a>
        <a class="button button-outline" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Chat on WhatsApp <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
