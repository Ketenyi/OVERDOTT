  }

  .velldot-module-status {
    margin: 0;
    color: #6c7a8f;
    font-size: 11px;
    white-space: nowrap;
  }

  .velldot-module-grid {
    display: grid;
    margin: 0;
    padding: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 34px;
    list-style: none;
  }

  .velldot-module-grid [hidden] {
    display: none !important;
  }

  .velldot-module-card {
    position: relative;
    padding: 23px 0 27px;
    border: 0;
    border-top: 1px solid var(--line);
    background: transparent;
    transition: border-color 180ms ease;
  }

  .velldot-module-card-top {
    margin-bottom: 17px;
  }

  .velldot-module-number {
    color: var(--blue);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .velldot-module-card h3 {
    margin-bottom: 10px;
    font-size: 1.23rem;
  }

  .velldot-module-card > p {
    min-height: 48px;
    margin-bottom: 18px;
    font-size: 13px;
    line-height: 1.7;
  }

  .velldot-module-features {
    display: flex;
    margin: 0;
    padding: 16px 0 0;
    border-top: 1px solid #edf0f5;
    flex-wrap: wrap;
    gap: 7px;
    list-style: none;
  }

  .velldot-module-features li {
    padding: 0;
    color: #5d6e85;
    font-size: 10px;
    font-weight: 600;
    line-height: 1.45;
  }

  .velldot-module-features li:not(:last-child)::after {
    margin-left: 7px;
    color: #9aa7b7;
    content: '·';
  }

  .velldot-module-footer {
    display: flex;
    margin-top: 24px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .velldot-module-footer p {
    margin: 0;
    color: #728095;
    font-size: 12px;
  }

  .velldot-value-section .section-heading {
    max-width: 800px;
  }

  .velldot-value-panels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .velldot-value-panel {
    display: flex;
    min-width: 0;
    min-height: 500px;
    padding: 27px;
    border: 1px solid var(--line);
    border-radius: 4px;
    flex-direction: column;
  }

  .velldot-value-panel-label {
    margin-bottom: 25px;
    color: #61738d;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .velldot-value-panel h3 {
    margin: 27px 0 11px;
    font-size: 1.28rem;
  }

  .velldot-value-panel > p {
    margin-bottom: 0;
    font-size: 13px;
    line-height: 1.75;
  }

  .velldot-value-modular {
    background: var(--mist-blue);
  }

  .velldot-workspace-diagram {
    display: grid;
    min-height: 190px;
    padding: 25px 18px 19px;
    border: 1px solid #d8e6f9;
    border-radius: 3px;
    align-content: center;
    background: rgba(255, 255, 255, 0.52);
  }

  .velldot-diagram-root {
    display: flex;
    width: fit-content;
    margin: 0 auto 27px;
    padding: 10px 13px;
    border: 1px solid #d4e2f4;
    border-radius: 3px;
    align-items: center;
    gap: 8px;
    color: #294668;
    background: #fff;
    font-size: 10px;
    font-weight: 800;
  }

  .velldot-diagram-root img {
    width: 19px;
    height: 19px;
  }

  .velldot-diagram-branches {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .velldot-diagram-branches::before {
    position: absolute;
    top: -28px;
    left: 50%;
    width: 1px;
    height: 28px;
    background: #bcd2ef;
    content: '';
  }

  .velldot-diagram-branches span {
    padding: 8px 6px;
    border: 1px solid #dbe6f4;
    border-radius: 2px;
    color: #587190;
    background: #fff;
    font-size: 9px;
    font-weight: 700;
    text-align: center;
  }

  .velldot-diagram-note {
    margin-top: 19px;
    color: #7388a2;
    font-size: 8px;
    font-weight: 600;
    text-align: center;
  }

  .velldot-value-security {
    border-color: var(--navy);
    color: #fff;
    background: var(--navy);
  }

  .velldot-value-security .velldot-value-panel-label {
    color: #8fa6c2;
  }

  .velldot-value-security h3 {
    color: #fff;
  }

  .velldot-value-security > p {
    color: #b7c6d9;
  }

  .velldot-security-visual {
    display: grid;
    min-height: 190px;
    border: 1px solid rgba(138, 184, 255, 0.2);
    border-radius: 3px;
    place-content: center;
    justify-items: center;
    gap: 15px;
    background: #0d1e34;
  }

  .velldot-security-visual svg {
    width: 68px;
    height: 68px;
    color: var(--blue-light);
  }

  .velldot-security-visual span {
    color: #8fa6c2;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .velldot-security-list {
    display: flex;
    margin: auto 0 0;
    padding: 18px 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    flex-wrap: wrap;
    gap: 7px;
    list-style: none;
  }

  .velldot-security-list li {
    padding: 0;
    color: #aebfd4;
    font-size: 9px;
  }

  .velldot-security-list li:not(:last-child)::after {
    margin-left: 7px;
    color: #5f7d9f;
    content: '·';
  }

  .velldot-reporting-visual {
    display: grid;
    min-height: 190px;
    padding: 22px;
    border: 1px solid #e0e7f0;
    border-radius: 3px;
    grid-template-columns: 1fr 1fr;
    align-content: center;
    gap: 12px;
    background: #f8fafc;
  }

  .velldot-report-file {
    display: grid;
    min-height: 108px;
    padding: 14px;
    border: 1px solid #dfe6ef;
    border-radius: 3px;
    align-content: start;
    gap: 8px;
    background: #fff;
  }

  .velldot-report-file span {
    margin-bottom: 5px;
    color: var(--blue);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .velldot-report-file i {
    display: block;
    height: 4px;
    border-radius: 4px;
    background: #e8edf4;
  }

  .velldot-report-file i:nth-of-type(2) {
    width: 76%;
  }

  .velldot-report-file i:nth-of-type(3) {
    width: 52%;
  }

  .velldot-report-link {
    display: flex;
    padding-top: 13px;
    border-top: 1px solid #dfe6ef;
    grid-column: 1 / -1;
    align-items: center;
    justify-content: center;
    gap: 15px;
    color: #5e7390;
    font-size: 10px;
    font-weight: 700;
  }

  .velldot-report-link i {
    color: var(--blue);
    font-size: 14px;
    font-style: normal;
  }

  .velldot-configuration-note {
    margin-top: auto;
    padding-top: 18px;
    color: #718096;
    font-size: 10px;
    font-weight: 600;
  }

  .velldot-kenya-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    align-items: center;
    gap: clamp(44px, 7vw, 90px);
  }

  .velldot-kenya-layout .section-heading {
    margin-bottom: 0;
  }

  .velldot-kenya-layout .section-heading .text-link {
    margin-top: 27px;
  }

  .velldot-kenya-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 15px;
  }

  .velldot-kenya-cards article {
    display: flex;
    min-height: 345px;
    padding: 27px 25px;
    border: 1px solid var(--line);
    border-radius: 4px;
    flex-direction: column;
    background: #fff;
  }

  .velldot-kenya-index {
    display: block;
    margin-bottom: 27px;
    padding-bottom: 16px;
    border-bottom: 1px solid #d8e0e8;
    color: var(--blue);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .velldot-kenya-tag {
    margin-bottom: 9px;
    color: var(--blue-dark);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .velldot-kenya-cards h3 {
    margin-bottom: 12px;
    font-size: 1.3rem;
  }

  .velldot-kenya-cards p {
    margin-bottom: 25px;
    font-size: 13px;
    line-height: 1.75;
  }

  .velldot-requirement {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid #edf0f5;
    color: #697a91;
    font-size: 10px;
    font-weight: 700;
  }

  .velldot-knowledge-panel {
    padding: 48px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--paper);
  }

  .velldot-knowledge-panel .section-heading {
    max-width: 700px;
    margin-bottom: 34px;
  }

  .velldot-knowledge-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  .velldot-knowledge-grid article {
    padding-top: 21px;
    border-top: 2px solid #bfd4f1;
  }

  .velldot-knowledge-number {
    display: block;
    margin-bottom: 17px;
    color: var(--blue);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .velldot-knowledge-grid h3 {
    margin-bottom: 10px;
    font-size: 1.08rem;
    line-height: 1.35;
  }

  .velldot-knowledge-grid p {
    margin-bottom: 0;
    font-size: 13px;
    line-height: 1.75;
  }

  .velldot-scope-note {
    margin: 32px 0 0;
    padding: 17px 20px;
    border-left: 3px solid var(--blue);
    color: #5d6d82;
    background: var(--mist);
    font-size: 12px;
    line-height: 1.7;
  }

  .velldot-scope-note strong {
    color: var(--ink);
  }

  .velldot-steps-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.84fr) minmax(0, 1.16fr);
    align-items: start;
    gap: clamp(50px, 8vw, 110px);
  }

  .velldot-steps-layout .section-heading {
    position: sticky;
    top: 120px;
    margin-bottom: 0;
  }

  .velldot-steps-layout .section-heading .text-link {
    margin-top: 26px;
  }

  .velldot-steps {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .velldot-steps li {
    position: relative;
    display: grid;
    padding: 0 0 30px 61px;
    grid-template-columns: minmax(0, 1fr);
  }

  .velldot-steps li::before {
    position: absolute;
    top: 43px;
    bottom: 0;
    left: 20px;
    width: 1px;
    background: #d6e0ec;
    content: '';
  }

  .velldot-steps li:last-child {
    padding-bottom: 0;
  }

  .velldot-steps li:last-child::before {
    display: none;
  }

  .velldot-steps li > span {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    width: 41px;
    height: 41px;
    border: 1px solid #cbdcf1;
    place-items: center;
    color: var(--blue);
    background: var(--mist-blue);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .velldot-steps h3 {
    margin: 4px 0 10px;
    font-size: 1.23rem;
  }

  .velldot-steps p {
    margin-bottom: 0;
    font-size: 14px;
    line-height: 1.75;
  }

  .velldot-pricing-heading {
    max-width: 780px;
  }

  .velldot-pricing-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .velldot-pricing-card {
    display: flex;
    min-height: 440px;
    padding: 34px;
    border: 1px solid #d9e5f5;
    border-radius: 4px;
    flex-direction: column;
    background: #fff;
  }

  .velldot-path-label {
    width: fit-content;
    margin-bottom: 30px;
    padding: 5px 0;
    border-top: 1px solid #b8c9d9;
    color: var(--blue-dark);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .velldot-pricing-card h3 {
    max-width: 430px;
    margin-bottom: 14px;
    font-size: 1.55rem;
    line-height: 1.25;
  }

  .velldot-pricing-card > p {
    max-width: 490px;
    margin-bottom: 20px;
    font-size: 14px;
    line-height: 1.75;
  }

  .velldot-pricing-card .check-list {
    margin: 3px 0 30px;
    font-size: 13px;
  }

  .velldot-pricing-card .button {
    width: fit-content;
    margin-top: auto;
  }

  .velldot-pricing-purchase {
    border-color: var(--navy);
    color: #fff;
    background: var(--navy);
  }

  .velldot-pricing-purchase .velldot-path-label {
    border-color: rgba(138, 184, 255, 0.35);
    color: #bcd7ff;
  }

  .velldot-pricing-purchase h3 {
    color: #fff;
  }

  .velldot-pricing-purchase > p,
  .velldot-pricing-purchase .check-list li {
    color: #bfcde0;
  }

  .velldot-pricing-purchase .check-list li::before {
    color: var(--blue-light);
  }

  .velldot-pricing-footer {
    display: flex;
    margin-top: 25px;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .velldot-pricing-footer p {
    margin: 0;
    color: #6b7a8f;
    font-size: 12px;
  }

  .velldot-faq-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    align-items: start;
    gap: clamp(48px, 8vw, 105px);
  }

  .velldot-faq-layout .section-heading {
    position: sticky;
    top: 120px;
    margin-bottom: 0;
  }

  .velldot-faq-layout .section-heading .text-link {
    margin-top: 25px;
  }

  .velldot-final-cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: 68px;
    color: #fff;
    background: var(--blue-dark);
  }

  .velldot-final-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 45px;
  }

  .velldot-final-inner > div:first-child {
    max-width: 720px;
  }

  .velldot-final-inner h2 {
    margin-bottom: 14px;
    color: #fff;
    font-size: clamp(2rem, 3.5vw, 3.15rem);
  }

  .velldot-final-inner p:not(.eyebrow) {
    max-width: 650px;
    margin-bottom: 0;
    color: #bdcadc;
  }

  .velldot-final-inner .velldot-actions {
    flex: 0 0 auto;
  }

  @media (hover: hover) {
    .velldot-module-card:hover {
      border-color: #9eb4c8;
    }
  }

  @media (max-width: 1080px) {
    .velldot-hero-inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(410px, 1.1fr);
      gap: 34px;
    }

    .velldot-hero h1 {
      font-size: clamp(2.8rem, 5.1vw, 4rem);
    }

    .velldot-app-shell {
      grid-template-columns: 112px minmax(0, 1fr);
    }

    .velldot-app-main {
      padding-inline: 16px;
    }

    .velldot-workflow-board {
      grid-template-columns: minmax(0, 1fr) minmax(145px, 0.72fr);
    }

    .velldot-value-panel {
      padding: 23px;
    }
  }

  @media (max-width: 940px) {
    .velldot-hero {
      padding-block: 66px 80px;
    }

    .velldot-hero-inner {
      grid-template-columns: 1fr;
      gap: 52px;
    }

    .velldot-hero-copy {
      max-width: 730px;
    }

    .velldot-hero h1 {
      max-width: 740px;
      font-size: clamp(3.2rem, 7.4vw, 4.8rem);
    }

    .velldot-product-visual {
      max-width: 690px;
      margin-inline: auto;
    }

    .velldot-app-shell {
      grid-template-columns: 140px minmax(0, 1fr);
    }

    .velldot-app-main {
      padding: 23px;
    }

    .velldot-portfolio-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .velldot-product-card-featured {
      grid-column: 1 / -1;
    }

    .velldot-product-card {
      min-height: 0;
    }

    .velldot-proof-strip ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px 0;
    }

    .velldot-proof-strip li:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .velldot-outcomes-layout,
    .velldot-steps-layout,
    .velldot-faq-layout,
    .velldot-kenya-layout {
      grid-template-columns: 1fr;
      gap: 42px;
    }

    .velldot-outcomes .section-heading,
    .velldot-steps-layout .section-heading,
    .velldot-faq-layout .section-heading {
      position: static;
    }

    .velldot-value-panels {
      grid-template-columns: 1fr;
    }

    .velldot-value-panel {
      display: grid;
      min-height: 0;
      grid-template-columns: minmax(240px, 0.8fr) minmax(0, 1.2fr);
      column-gap: 30px;
    }

    .velldot-value-panel-label {
      grid-column: 1 / -1;
    }

    .velldot-workspace-diagram,
    .velldot-security-visual,
    .velldot-reporting-visual {
      grid-row: 2 / span 3;
    }

    .velldot-value-panel h3 {
      margin-top: 0;
    }

    .velldot-security-list,
    .velldot-configuration-note {
      align-self: end;
    }

    .velldot-kenya-cards {
      max-width: 760px;
    }
  }

  @media (max-width: 720px) {
    .velldot-portfolio-grid {
      grid-template-columns: 1fr;
    }

    .velldot-product-card-featured {
      grid-column: auto;
    }

    .velldot-module-toolbar {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }

    .velldot-module-grid {
      grid-template-columns: 1fr;
    }

    .velldot-module-card > p {
      min-height: 0;
    }

    .velldot-module-footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }

    .velldot-value-panel {
      display: flex;
      min-height: 480px;
    }

    .velldot-value-panel h3 {
      margin-top: 27px;
    }

    .velldot-kenya-cards {
      grid-template-columns: 1fr;
    }

    .velldot-kenya-cards article {
      min-height: 0;
    }

    .velldot-knowledge-panel {
      padding: 34px 28px;
    }

    .velldot-knowledge-grid {
      grid-template-columns: 1fr;
      gap: 26px;
    }

    .velldot-pricing-grid {
      grid-template-columns: 1fr;
    }

    .velldot-pricing-card {
      min-height: 0;
    }

    .velldot-final-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 30px;
    }
  }

  @media (max-width: 600px) {
    .velldot-hero {
      padding-block: 52px 66px;
    }

    .velldot-wordmark {
      margin-bottom: 32px;
    }

    .velldot-wordmark img {
      width: 205px;
    }

    .velldot-hero h1 {
      font-size: clamp(2.7rem, 12vw, 3.7rem);
    }

    .velldot-hero .velldot-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .velldot-hero .velldot-actions .button {
      width: 100%;
    }

    .velldot-hero .velldot-actions .text-link {
      width: fit-content;
      margin-top: 4px;
    }

    .velldot-product-visual figcaption {
      align-items: flex-start;
      flex-direction: column;
      gap: 3px;
    }

    .velldot-app-shell {
      min-height: 0;
      grid-template-columns: 1fr;
    }

    .velldot-app-sidebar {
      display: none;
    }

    .velldot-app-main {
      padding: 18px 15px 15px;
    }

    .velldot-app-badge {
      display: none;
    }

    .velldot-workflow-board {
      grid-template-columns: 1fr;
    }

    .velldot-app-side-stack {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto;
    }

    .velldot-mini-panel {
      padding: 12px;
    }

    .velldot-panel-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 3px;
    }

    .velldot-finance-flow {
      flex-wrap: wrap;
      justify-content: flex-start;
    }

    .velldot-app-module-strip {
      align-items: flex-start;
      flex-direction: column;
    }

    .velldot-app-module-strip > div {
      justify-content: flex-start;
    }

    .velldot-proof-strip ul {
      padding-block: 23px;
      gap: 20px 0;
    }

    .velldot-proof-strip li {
      padding-inline: 15px;
    }

    .velldot-proof-strip strong {
      font-size: 12px;
    }

    .velldot-proof-strip span {
      font-size: 10px;
    }

    .velldot-outcome-list article {
      grid-template-columns: 33px minmax(0, 1fr);
      gap: 12px;
    }

    .velldot-module-filters {
      width: 100%;
    }

    .velldot-module-filter {
      flex: 1 1 auto;
      padding-inline: 10px;
    }

    .velldot-pricing-card {
      padding: 28px 24px;
    }

    .velldot-pricing-card .button {
      width: 100%;
    }

    .velldot-pricing-footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 5px;
    }

    .velldot-final-cta {
      padding-block: 64px;
    }

    .velldot-final-inner .velldot-actions {
      width: 100%;
      align-items: stretch;
      flex-direction: column;
    }

    .velldot-final-inner .velldot-actions .button {
      width: 100%;
    }
  }

  @media (max-width: 390px) {
    .velldot-app-side-stack {
      grid-template-columns: 1fr;
    }

    .velldot-proof-strip ul {
      grid-template-columns: 1fr;
    }

    .velldot-proof-strip li,
    .velldot-proof-strip li:nth-child(3) {
      padding: 0 0 17px;
      border-bottom: 1px solid var(--line);
      border-left: 0;
    }

