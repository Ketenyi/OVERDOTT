  @media (prefers-reduced-motion: reduce) {
    .velldot-module-card,
    .velldot-module-filter {
      transition: none;
    }

    .velldot-module-card:hover {
      transform: none;
    }
  }
</style>

<script>
  const filterGroup = document.querySelector<HTMLElement>('[data-module-filters]');
  const moduleGrid = document.querySelector<HTMLElement>('[data-module-grid]');
  const moduleStatus = document.querySelector<HTMLElement>('[data-module-status]');
  const filterButtons = Array.from(
    filterGroup?.querySelectorAll<HTMLButtonElement>('[data-module-filter]') ?? [],
  );
  const moduleCards = Array.from(
    moduleGrid?.querySelectorAll<HTMLElement>('[data-module-card]') ?? [],
  );

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const selectedFilter = button.dataset.moduleFilter ?? 'all';
      let visibleCount = 0;

      filterButtons.forEach((filterButton) => {
        filterButton.setAttribute(
          'aria-pressed',
          String(filterButton === button),
        );
      });

      moduleCards.forEach((card) => {
        const categories = (card.dataset.categories ?? '').split(/\s+/);
        const isVisible =
          selectedFilter === 'all' || categories.includes(selectedFilter);
        card.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      });

      if (moduleStatus) {
        const activeLabel = button.dataset.filterLabel ?? 'selected area';
        moduleStatus.textContent =
          selectedFilter === 'all'
            ? `Showing all ${visibleCount} modules.`
            : `Showing ${visibleCount} ${visibleCount === 1 ? 'module' : 'modules'} in ${activeLabel}.`;
      }
    });
  });
</script>
