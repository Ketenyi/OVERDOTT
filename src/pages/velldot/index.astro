---
import BaseLayout from '../../layouts/BaseLayout.astro';

const resolveAppUrl = (value: string | undefined) => {
  const trimmed = value?.trim();
  if (!trimmed) return null;

  try {
    const url = new URL(trimmed);
    return ['http:', 'https:'].includes(url.protocol) ? url : null;
  } catch {
    return null;
  }
};

const appUrl =
  resolveAppUrl(import.meta.env.PUBLIC_VELLDOT_URL) ??
  resolveAppUrl(import.meta.env.PUBLIC_SORA_URL);
const appConfigured = Boolean(appUrl);
const appPath = (path: string) => (appUrl ? new URL(path, appUrl).toString() : '');
const externalLinkProps = appConfigured ? { target: '_blank', rel: 'noopener noreferrer' } : {};

const earlyAccessUrl = '/contact/?interest=velldot-early-access#enquiry';
const deploymentUrl = '/contact/?interest=velldot-deployment#enquiry';
const documentationUrl =
  appPath('/documentation/') || '/contact/?interest=velldot-documentation#enquiry';
const appContactUrl =
  appPath('/contact') || '/contact/?interest=velldot-contact#enquiry';

const earlyAccessCtaLabel = 'Register Interest for Early Access';
const deploymentCtaLabel = 'Discuss Deployment & Licensing';
const documentationLabel = appConfigured
  ? 'Explore app documentation'
  : 'Ask about documentation';
const appContactLabel = appConfigured ? 'Contact Velldot' : 'Contact Overdott';

const moduleFilters = [
  { value: 'all', label: 'All' },
  { value: 'finance-sales', label: 'Finance & sales' },
  { value: 'operations', label: 'Operations' },
  { value: 'people-assets', label: 'People & assets' },
];

const modules = [
  {
    name: 'Projects',
    category: 'operations',
    description:
      'Plan and govern delivery from portfolio and tender stages through tasks, approvals, costs and service commitments.',
    features: [
      'Portfolios, tenders & Gantt',
      'Tasks, kanban & teams',
      'Timesheets, expenses & minutes',
      'Change control, UAT & SLA',
      'Analytics & scheduled reports',
    ],
  },
  {
    name: 'Finance',
    category: 'finance-sales',
    description:
      'Keep core accounting and receivables in a structured finance workspace, from quotations to financial statements.',
    features: [
      'Quotations, invoices & receivables',
      'Chart of accounts, journals & ledger',
      'Trial balance & financial statements',
      'Banking',
    ],
  },
  {
    name: 'Procurement',
    category: 'finance-sales',
    description:
      'Manage purchasing and supplier obligations with a clear path from requests and orders to receipts, bills and payments.',
    features: [
      'Purchase orders & RFQs',
      'Goods receipts',
      'Supplier bills & payments',
      'Accounts-payable aging',
    ],
  },
  {
    name: 'Sales & CRM',
    category: 'finance-sales',
    description:
      'Organize quotations, sales opportunities and business relationships, with reporting and exports for review.',
    features: ['Quotes & pipeline', 'Clients & vendors', 'Reports & exports'],
  },
  {
    name: 'Human Resources',
    category: 'people-assets',
    description:
      'Support the employee lifecycle with records, time and leave, talent processes, payroll and people analytics.',
    features: [
      'Employees, attendance & leave',
      'Recruitment & performance',
      'Payroll, payslips & training',
      'Succession & analytics',
    ],
  },
  {
    name: 'Inventory',
    category: 'operations',
    description:
      'Track products and stock activity, including movements between locations, adjustments, valuation and low-stock reporting.',
    features: [
      'Products & stock movements',
      'Transfers & adjustments',
      'Valuation & low-stock reports',
    ],
  },
  {
    name: 'Helpdesk',
    category: 'operations',
    description:
      'Structure service intake, assignment and follow-up with ticket teams, service targets, feedback and email ingestion.',
    features: ['Tickets, teams & routing', 'SLA, surveys & contracts', 'Email ingestion'],
  },
  {
    name: 'Assets',
    category: 'people-assets',
    description:
      'Maintain an asset register through custody, maintenance and depreciation, with labels and endpoint-agent inventory.',
    features: [
      'Register, labels & maintenance',
      'Depreciation',
      'Endpoint-agent enrollment & inventory',
    ],
  },
  {
    name: 'Point of Sale',
    category: 'operations',
    description:
      'Run till sessions, checkout, receipts, refunds, voids and operator reporting. Finance posting requires Finance to be licensed and mapped.',
    features: ['Checkout, receipts & reports', 'Refunds, voids & operators', 'Till sessions'],
  },
  {
    name: 'Signatures',
    category: 'people-assets',
    description:
      'Manage consistent email identity and digital contact sharing through templates, deployment queues and mailbox integrations.',
    features: [
      'Templates & deployment queues',
      'Mailbox integrations',
      'Digital cards, QR/vCard & wallet passes',
    ],
  },
];

const faqs = [
  {
    question: 'What is Velldot ERP?',
    answer:
      'Velldot ERP is a product initiative by Overdott. The verified build is a web-based ERP built on Django, with modular organization workspaces, tenant-scoped business rows and separate tools for tenant owners and platform administrators. Commercial availability is confirmed by enquiry.',
  },
  {
    question: 'Which business modules are included in the verified build?',
    answer:
      'The verified build includes Projects, Finance, Procurement, Sales & CRM, Human Resources, Inventory, Helpdesk, Assets, Point of Sale and Signatures. The modules enabled for an organization depend on licensing and configuration.',
  },
  {
    question: 'Can we register for a trial?',
    answer:
      'You can register interest for early access. The verified application includes configurable signup and trial flows, but public access, trial duration and terms depend on the deployment. Overdott confirms whether a trial is available for your requirements.',
  },
  {
    question: 'Who manages users, billing and module licences?',
    answer:
      'Tenant owners manage users, billing, renewals and domains. Module licence changes are restricted to platform administrators; tenant owners do not change module licences themselves.',
  },
  {
    question: 'How are pricing and payments handled?',
    answer:
      'This corporate website does not publish prices or edition names. Pricing, licensing and payment availability are confirmed with Overdott. The verified application supports Stripe Checkout and M-Pesa STK Push for authenticated renewals when those options are configured.',
  },
  {
    question: 'Which Kenya-oriented workflows are supported?',
    answer:
      'eTIMS transport and retry queues are available when configured, and queue processing requires a worker. M-Pesa STK Push is available for authenticated renewals when configured, with M-Pesa also available as a payment option in supported workflows.',
  },
  {
    question: 'Can Velldot ERP or Point of Sale work offline?',
    answer:
      'No. Velldot is a cloud application and requires internet connectivity. It is not an offline ERP or POS.',
  },
  {
    question: 'Does Point of Sale post to Finance automatically?',
    answer:
      'Only when the Finance module is licensed and mapped. POS configuration should be confirmed during onboarding so the intended finance workflow is clear.',
  },
  {
    question: 'What reporting and access controls are included?',
    answer:
      'PDF and CSV reporting are available across modules. Verified controls include TOTP MFA, login throttling, audit middleware, security headers and private tenant-media checks. These controls should be considered alongside your own access and deployment requirements.',
  },
  {
    question: 'Can Overdott help with onboarding and support?',
    answer:
      'Yes. Onboarding and support can be scoped with Overdott around your chosen modules, configuration, rollout and team requirements.',
  },
];

const softwareApplicationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Velldot ERP',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  provider: {
    '@type': 'Organization',
    name: 'Overdott Technologies Limited',
  },
  ...(appUrl ? { url: appUrl.toString() } : {}),
};
---

<BaseLayout
  title="Velldot | Business Software by Overdott"
  description="Explore Velldot, Overdott's business software initiative, including verified Velldot ERP capabilities and Velldot HR and Projects in development."
  image="/velldot-social.png"
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(softwareApplicationJsonLd)}
  />

  <section class="velldot-hero" aria-labelledby="velldot-hero-title">
    <div class="page-width velldot-hero-inner">
      <div class="velldot-hero-copy">
        <a class="velldot-wordmark" href="#main" aria-label="Velldot ERP">
          <img
            src="/velldot-wordmark-white.svg"
            alt="Velldot"
            width="232"
            height="56"
          />
        </a>
        <p class="eyebrow">Introducing Velldot · By Overdott</p>
        <h1 id="velldot-hero-title">Business software.<br /><span class="editorial-accent">Simplified.</span></h1>
        <p class="velldot-lead">
          Introducing Velldot — practical business applications for modern organizations. Our software product initiative is focused on simplifying operations, improving visibility and helping organizations manage their resources more effectively.
        </p>
        <div class="velldot-actions">
          <a class="button" href={earlyAccessUrl}>
            {earlyAccessCtaLabel}
            <span aria-hidden="true">↗</span>
          </a>
          <a class="button button-outline" href={deploymentUrl}>
            {deploymentCtaLabel}
            <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link velldot-text-link-light" href="#portfolio">
            Explore the portfolio <span aria-hidden="true">→</span>
          </a>
        </div>
        <p class="velldot-trial-note">
          <span aria-hidden="true"></span>
          Product initiative by Overdott · Availability confirmed by enquiry.
        </p>
        <p class="velldot-pricing-note">
          No pricing is published here. Trial access, deployment, licensing and payment options are confirmed individually.
        </p>
      </div>

      <figure class="velldot-product-visual">
        <figcaption>
          <span>Illustrative product view</span>
          <span>Not a live screenshot</span>
        </figcaption>
        <div class="velldot-product-frame" aria-hidden="true">
          <div class="velldot-window-bar">
            <img src="/velldot-mark.svg" alt="" width="24" height="24" />
            <span>VELLDOT WORKSPACE</span>
            <span class="velldot-window-status"><i></i> Web application</span>
          </div>
          <div class="velldot-app-shell">
            <aside class="velldot-app-sidebar">
              <div class="velldot-sidebar-label">WORKSPACE</div>
              <div class="velldot-sidebar-item is-active"><i>P</i><span>Projects</span></div>
              <div class="velldot-sidebar-item"><i>F</i><span>Finance</span></div>
              <div class="velldot-sidebar-item"><i>Pr</i><span>Procurement</span></div>
              <div class="velldot-sidebar-item"><i>S</i><span>Sales &amp; CRM</span></div>
              <div class="velldot-sidebar-item"><i>H</i><span>People</span></div>
              <div class="velldot-sidebar-item"><i>In</i><span>Inventory</span></div>
              <div class="velldot-sidebar-footer"><span></span> Organization workspace</div>
            </aside>
            <div class="velldot-app-main">
              <div class="velldot-app-heading">
                <div>
                  <small>PROJECTS</small>
                  <strong>Delivery overview</strong>
                </div>
                <span class="velldot-app-badge">Planning &amp; approvals</span>
              </div>
              <div class="velldot-workflow-board">
                <div class="velldot-timeline-panel">
                  <div class="velldot-panel-heading">
                    <strong>Project plan</strong>
                    <span>Tender to handover</span>
                  </div>
                  <div class="velldot-timeline">
                    <div class="velldot-timeline-row">
                      <span class="velldot-timeline-dot"></span>
                      <div><strong>Tender &amp; planning</strong><small>Scope and delivery plan</small></div>
                      <span class="velldot-row-status">Plan</span>
                    </div>
                    <div class="velldot-timeline-row">
                      <span class="velldot-timeline-dot"></span>
                      <div><strong>Delivery milestones</strong><small>Tasks, teams and time</small></div>
                      <span class="velldot-row-status">Track</span>
                    </div>
                    <div class="velldot-timeline-row">
                      <span class="velldot-timeline-dot"></span>
                      <div><strong>UAT approvals</strong><small>Review and sign-off</small></div>
                      <span class="velldot-row-status">Review</span>
                    </div>
                    <div class="velldot-timeline-row">
                      <span class="velldot-timeline-dot"></span>
                      <div><strong>SLA &amp; handover</strong><small>Service commitments</small></div>
                      <span class="velldot-row-status">Prepare</span>
                    </div>
                  </div>
                </div>
                <div class="velldot-app-side-stack">
                  <div class="velldot-mini-panel">
                    <div class="velldot-panel-heading">
                      <strong>Approval queue</strong>
                      <span>Project controls</span>
                    </div>
                    <div class="velldot-approval-row"><span>Change control</span><b>Review</b></div>
                    <div class="velldot-approval-row"><span>UAT sign-off</span><b>Approve</b></div>
                  </div>
                  <div class="velldot-mini-panel velldot-finance-panel">
                    <div class="velldot-panel-heading">
                      <strong>Finance workflow</strong>
                      <span>Licensed module</span>
                    </div>
                    <div class="velldot-finance-flow">
                      <span>Invoice</span><i>→</i><span>Receivable</span><i>→</i><span>Ledger</span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="velldot-app-module-strip">
                <span>MODULES IN VIEW</span>
                <div>
                  <b>Projects</b><b>Finance</b><b>Procurement</b><b>Sales &amp; CRM</b><b>+ more</b>
                </div>
              </div>
            </div>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <section class="velldot-proof-strip" aria-label="Velldot ERP at a glance">
    <ul class="page-width">
      <li><strong>10 business modules</strong><span>Delivery through signatures</span></li>
      <li><strong>Organization workspaces</strong><span>Tenant-scoped business rows</span></li>
      <li><strong>PDF + CSV</strong><span>Reporting across modules</span></li>
      <li><strong>Kenya workflows</strong><span>eTIMS and M-Pesa, when configured</span></li>
    </ul>
  </section>

  <section class="section page-width velldot-portfolio" id="portfolio" aria-labelledby="velldot-portfolio-title">
    <div class="section-heading">
      <p class="eyebrow">The Velldot portfolio</p>
      <h2 id="velldot-portfolio-title">One product family. A practical business focus.</h2>
      <p>Velldot is a proprietary software initiative associated with Overdott. Product status is shown clearly so organizations can distinguish verified capabilities from work still in development.</p>
    </div>
    <div class="velldot-portfolio-grid">
      <article class="velldot-product-card velldot-product-card-featured">
        <span class="velldot-product-status">Verified ERP build</span>
        <h3>Velldot ERP</h3>
        <p>An integrated business management platform designed to bring essential business operations together.</p>
        <ul class="velldot-product-points">
          <li>10 verified business modules</li>
          <li>Modular organization workspaces</li>
          <li>Deployment and availability by enquiry</li>
        </ul>
        <a class="text-link" href="#modules">Explore ERP capabilities <span aria-hidden="true">→</span></a>
      </article>
      <article class="velldot-product-card">
        <span class="velldot-product-status">In development</span>
        <h3>Velldot HR</h3>
        <p>A business application initiative focused on employee information and HR processes.</p>
        <a class="text-link" href={earlyAccessUrl}>Register product interest <span aria-hidden="true">→</span></a>
      </article>
      <article class="velldot-product-card">
        <span class="velldot-product-status">In development</span>
        <h3>Velldot Projects</h3>
        <p>A project management application initiative designed to help teams organize work, monitor progress and manage responsibilities.</p>
        <a class="text-link" href={earlyAccessUrl}>Register product interest <span aria-hidden="true">→</span></a>
      </article>
    </div>
    <p class="velldot-portfolio-note">Status labels describe the verified build and current product initiatives; they are not a promise of commercial availability.</p>
  </section>

  <section class="section page-width velldot-outcomes" aria-labelledby="velldot-outcomes-title">
    <div class="velldot-outcomes-layout">
      <div class="section-heading">
        <p class="eyebrow">Business outcomes</p>
        <h2 id="velldot-outcomes-title">Less switching.<br />More perspective.</h2>
        <p>
          Give each function the tools it needs while keeping the wider business in view.
        </p>
      </div>
      <div class="velldot-outcome-list">
        <article>
          <span>01</span>
          <div>
            <h3>See the whole operation</h3>
            <p>Review delivery, financial, customer and workforce work in a shared ERP experience instead of treating each function as an island.</p>
          </div>
        </article>
        <article>
          <span>02</span>
          <div>
            <h3>Make hand-offs clearer</h3>
            <p>Keep related records visible in the right workflows—from project time and expenses to goods receipts, supplier bills and receivables.</p>
          </div>
        </article>
        <article>
          <span>03</span>
          <div>
            <h3>Scale with intention</h3>
            <p>Apply modules by licence and configuration, manage users and billing through tenant-owner tools, and export reports when you need them.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-tint velldot-modules-section" id="modules" aria-labelledby="velldot-modules-title">
    <div class="page-width">
      <div class="section-heading">
        <p class="eyebrow">The module suite</p>
        <h2 id="velldot-modules-title">Ten modules. One business toolkit.</h2>
        <p>
          Explore verified capabilities across finance, operations, people and assets. Your available modules depend on licensing and configuration.
        </p>
      </div>

      <div class="velldot-module-toolbar">
        <div
          class="velldot-module-filters"
          role="group"
          aria-label="Filter modules by business area"
          data-module-filters
        >
          {moduleFilters.map((filter) => (
            <button
              type="button"
              class="velldot-module-filter"
              data-module-filter={filter.value}
              data-filter-label={filter.label}
              aria-pressed={filter.value === 'all'}
              aria-controls="velldot-module-grid"
            >
              {filter.label}
            </button>
          ))}
        </div>
        <p class="velldot-module-status" role="status" aria-live="polite" data-module-status>
          Showing all 10 modules.
        </p>
      </div>

      <ul class="velldot-module-grid" id="velldot-module-grid" data-module-grid>
        {modules.map((module, index) => (
          <li
            class="velldot-module-card"
            data-module-card
            data-categories={module.category}
            data-module-name={module.name}
          >
            <div class="velldot-module-card-top">
              <span class="velldot-module-number">Module {String(index + 1).padStart(2, '0')}</span>
            </div>
            <h3>{module.name}</h3>
            <p>{module.description}</p>
            <ul class="velldot-module-features">
              {module.features.map((feature) => <li>{feature}</li>)}
            </ul>
          </li>
        ))}
      </ul>

      <div class="velldot-module-footer">
        <p>Module licence changes are made by platform administrators.</p>
        <a class="text-link" href={documentationUrl} {...externalLinkProps}>
          {documentationLabel} <span aria-hidden="true">↗</span>
          {appConfigured && <span class="sr-only"> (opens in a new tab)</span>}
        </a>
      </div>
    </div>
  </section>

  <section class="section page-width velldot-value-section" aria-labelledby="velldot-value-title">
    <div class="section-heading">
      <p class="eyebrow">Built around your organization</p>
      <h2 id="velldot-value-title">A workspace with clear boundaries and useful depth.</h2>
      <p>
        Review the business capabilities in the verified build, then confirm the modules, access controls and connected workflows appropriate for your deployment.
      </p>
    </div>

    <div class="velldot-value-panels">
      <article class="velldot-value-panel velldot-value-modular">
        <div class="velldot-value-panel-label">01 / Modular workspaces</div>
        <div class="velldot-workspace-diagram" aria-hidden="true">
          <div class="velldot-diagram-root"><img src="/velldot-mark.svg" alt="" width="24" height="24" /> Organization workspace</div>
          <div class="velldot-diagram-branches">
            <span>Projects</span><span>Finance</span><span>People</span><span>Operations</span>
          </div>
          <div class="velldot-diagram-note">Licensed modules · Configured access</div>
        </div>
        <h3>Start focused. Add deliberately.</h3>
        <p>
          Where public signup is enabled, it provisions a tenant, owner, settings and module licences. Tenant owners manage users, billing, renewals and domains; platform administrators handle module licence changes.
        </p>
      </article>

      <article class="velldot-value-panel velldot-value-security">
        <div class="velldot-value-panel-label">02 / Security &amp; access</div>
        <div class="velldot-security-visual" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M24 4 40 11v12c0 10-6 17-16 21C14 40 8 33 8 23V11L24 4Z"></path>
            <path d="m17 24 5 5 10-11"></path>
          </svg>
          <span>ACCESS CONTROLS</span>
        </div>
        <h3>Control how people enter and work.</h3>
        <p>
          Verified controls include TOTP MFA, login throttling, audit middleware, security headers and checks for private tenant media.
        </p>
        <ul class="velldot-security-list">
          <li>Role-aware access</li>
          <li>Authentication controls</li>
          <li>Audit and request protections</li>
        </ul>
      </article>

      <article class="velldot-value-panel velldot-value-reporting">
        <div class="velldot-value-panel-label">03 / Reporting &amp; integrations</div>
        <div class="velldot-reporting-visual" aria-hidden="true">
          <div class="velldot-report-file"><span>PDF</span><i></i><i></i><i></i></div>
          <div class="velldot-report-file"><span>CSV</span><i></i><i></i><i></i></div>
          <div class="velldot-report-link"><span>eTIMS</span><i>↔</i><span>M-Pesa</span></div>
        </div>
        <h3>Take reporting further.</h3>
        <p>
          Generate PDF and CSV reports across modules. Connect Kenya-oriented eTIMS and M-Pesa workflows where the required services and configuration are in place.
        </p>
        <span class="velldot-configuration-note">Integration availability is configuration-dependent.</span>
      </article>
    </div>
  </section>

  <section class="section section-tint velldot-kenya-section" aria-labelledby="velldot-kenya-title">
    <div class="page-width velldot-kenya-layout">
      <div class="section-heading">
        <p class="eyebrow">Kenya-oriented workflows</p>
        <h2 id="velldot-kenya-title">Connect the processes your team already uses.</h2>
        <p>
          eTIMS and M-Pesa options are available when configured. Confirm the required setup and service availability with Overdott before rollout.
        </p>
        <a class="text-link" href={appContactUrl} {...externalLinkProps}>
          {appContactLabel} <span aria-hidden="true">↗</span>
          {appConfigured && <span class="sr-only"> (opens in a new tab)</span>}
        </a>
      </div>
      <div class="velldot-kenya-cards">
        <article>
          <span class="velldot-kenya-index" aria-hidden="true">01</span>
          <span class="velldot-kenya-tag">Tax workflow</span>
          <h3>eTIMS transport</h3>
          <p>
            Transport and retry queues support eTIMS workflows when configured. A worker is required to process the queues.
          </p>
          <span class="velldot-requirement">Configuration + worker required</span>
        </article>
        <article>
          <span class="velldot-kenya-index" aria-hidden="true">02</span>
          <span class="velldot-kenya-tag">Payment workflow</span>
          <h3>M-Pesa</h3>
          <p>
            Authenticated renewal can use M-Pesa STK Push when configured. M-Pesa is also available as a payment option in supported workflows.
          </p>
          <span class="velldot-requirement">Payment configuration required</span>
        </article>
      </div>
    </div>
  </section>

  <section class="section velldot-knowledge-section" aria-labelledby="velldot-knowledge-title">
    <div class="page-width">
      <div class="velldot-knowledge-panel">
        <div class="section-heading">
          <p class="eyebrow">Good to know</p>
          <h2 id="velldot-knowledge-title">Clear expectations before you begin.</h2>
          <p>A few practical boundaries help you plan the right deployment, licences and support.</p>
        </div>
        <div class="velldot-knowledge-grid">
          <article>
            <span class="velldot-knowledge-number">01</span>
            <h3>Cloud connectivity is required</h3>
