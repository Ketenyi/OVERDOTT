---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { insights } from '../../data/insights';
import { whatsappNumber } from '../../config';

const topics = Array.from(new Set(insights.map((article) => article.category)));
const whatsappUrl = `https://wa.me/${whatsappNumber}`;
---

<BaseLayout
  title="Technology Insights for Business | Overdott Technologies"
  description="Practical articles on IT infrastructure, cybersecurity, cloud, business software and websites for organizations in Kenya."
>
  <section class="page-hero page-hero-split">
    <div class="page-width page-hero-inner">
      <div class="page-hero-copy">
        <p class="eyebrow">Insights</p>
        <h1>Useful context for technology decisions.</h1>
        <p>Plain-language perspectives on infrastructure, security, IT management, software and digital services.</p>
      </div>
      <aside class="page-hero-aside" aria-label="Topics covered in our insights">
        <div class="hero-panel">
          <p class="hero-panel-label">Topics we cover</p>
          <ul class="hero-panel-list">
            {topics.map((topic) => <li>{topic}</li>)}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section-compact section-tint">
    <div class="page-width">
      <div class="section-heading">
        <p class="eyebrow">From the insights desk</p>
        <h2>Practical reading for better technology decisions.</h2>
      </div>
      <div class="card-grid">
        {insights.map((article, index) => (
          <article class={index === 0 ? 'insight-card insight-card-featured' : 'insight-card'}>
            <span class="insight-meta">{article.category} · {article.readTime}</span>
            <h3>{article.title}</h3>
            <p>{article.description}</p>
            <a class="text-link" href={`/insights/${article.slug}/`}>
              Read article <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="page-width cta-inner">
      <div>
        <p class="eyebrow">Start a conversation</p>
        <h2>Have a technology question for your organization?</h2>
        <p>Share a little context and we’ll help identify a practical next step.</p>
      </div>
      <div class="cta-actions">
        <a class="button button-light" href="/contact/">
          Contact Overdott <span aria-hidden="true">↗</span>
        </a>
        <a class="button button-outline" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
          Chat on WhatsApp <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>