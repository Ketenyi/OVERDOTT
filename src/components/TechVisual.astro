---
const nodes = [
  { label: 'Secure', detail: 'By design', class: 'node-secure', icon: 'shield' },
  { label: 'Build', detail: 'Custom software', class: 'node-build', icon: 'code' },
  { label: 'Connect', detail: 'Your systems', class: 'node-connect', icon: 'connect' },
  { label: 'Manage', detail: 'With clarity', class: 'node-manage', icon: 'manage' },
];
---

<div class="tech-visual" aria-hidden="true">
  <div class="tech-grid"></div>
  <div class="tech-glow"></div>
  <svg class="connection-map" viewBox="0 0 520 520" fill="none">
    <defs>
      <linearGradient id="connection-gradient" x1="120" y1="90" x2="410" y2="440" gradientUnits="userSpaceOnUse">
        <stop stop-color="#8ab8ff" stop-opacity=".8" />
        <stop offset="1" stop-color="#2675e8" stop-opacity=".18" />
      </linearGradient>
    </defs>
    <path d="M260 260L118 112M260 260L414 138M260 260L104 408M260 260L402 422" stroke="url(#connection-gradient)" stroke-width="1.2" />
    <path d="M260 260L118 112M260 260L414 138M260 260L104 408M260 260L402 422" stroke="#8ab8ff" stroke-opacity=".35" stroke-width="1" stroke-dasharray="3 8" />
    <circle cx="118" cy="112" r="4" fill="#8ab8ff" />
    <circle cx="414" cy="138" r="4" fill="#8ab8ff" />
    <circle cx="104" cy="408" r="4" fill="#8ab8ff" />
    <circle cx="402" cy="422" r="4" fill="#8ab8ff" />
  </svg>
  <div class="orbit orbit-one"></div>
  <div class="orbit orbit-two"></div>
  <div class="tech-hub">
    <div class="hub-ring"></div>
    <img src="/brand/overdott-mark-white.png" alt="" width="74" height="74" />
    <span>OVERDOTT</span>
  </div>
  {nodes.map((node) => (
    <div class={`tech-node ${node.class}`}>
      <span class={`node-icon icon-${node.icon}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          {node.icon === 'shield' && <><path d="M12 3 19 6v5c0 4.4-2.9 8-7 10-4.1-2-7-5.6-7-10V6l7-3Z" /><path d="m9 12 2 2 4-4" /></>}
          {node.icon === 'code' && <><path d="m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16" /></>}
          {node.icon === 'connect' && <><circle cx="6" cy="12" r="3" /><circle cx="18" cy="6" r="3" /><circle cx="18" cy="18" r="3" /><path d="m9 11 6-4M9 13l6 4" /></>}
          {node.icon === 'manage' && <><path d="M4 19V9M10 19V5M16 19v-7M22 19H2" /></>}
        </svg>
      </span>
      <span class="node-copy"><strong>{node.label}</strong><small>{node.detail}</small></span>
      <i></i>
    </div>
  ))}
  <div class="tech-caption"><span></span> One connected technology partner</div>
</div>

<style>
  .tech-visual {
    position: relative;
    width: 100%;
    min-width: 0;
    max-width: 540px;
    aspect-ratio: 1 / 1;
    margin-inline: auto;
  }

  .tech-grid,
  .tech-glow,
  .connection-map,
  .orbit {
    position: absolute;
    inset: 0;
  }

  .tech-grid {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(circle, #000 20%, transparent 70%);
  }

  .tech-glow {
    background: radial-gradient(circle at center, rgba(38, 117, 232, 0.3), transparent 45%);
    filter: blur(12px);
  }

  .connection-map {
    width: 100%;
    height: 100%;
  }

  .orbit {
    top: 50%;
    left: 50%;
    width: 76%;
    height: 48%;
    border: 1px solid rgba(138, 184, 255, 0.18);
    border-radius: 50%;
    transform: translate(-50%, -50%) rotate(-22deg);
  }

  .orbit-two {
    width: 56%;
    height: 76%;
    border-color: rgba(138, 184, 255, 0.1);
    transform: translate(-50%, -50%) rotate(36deg);
  }

  .tech-hub {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 152px;
    height: 152px;
    border: 1px solid rgba(158, 197, 255, 0.34);
    border-radius: 36px;
    place-items: center;
    background: linear-gradient(145deg, rgba(31, 71, 124, 0.96), rgba(10, 29, 54, 0.98));
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.38), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    transform: translate(-50%, -50%) rotate(-6deg);
  }

  .tech-hub img {
    width: 72px;
    height: 72px;
    transform: rotate(6deg);
  }

  .tech-hub > span {
    margin-top: -12px;
    color: #b9d2f7;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.24em;
    transform: rotate(6deg);
  }

  .hub-ring {
    position: absolute;
    inset: -13px;
    border: 1px solid rgba(138, 184, 255, 0.12);
    border-radius: 46px;
  }

  .tech-node {
    position: absolute;
    display: flex;
    min-width: 154px;
    padding: 13px 14px;
    border: 1px solid rgba(170, 204, 255, 0.2);
    border-radius: 12px;
    align-items: center;
    gap: 11px;
    background: rgba(12, 34, 62, 0.9);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.24);
    backdrop-filter: blur(12px);
  }

  .node-secure {
    top: 14%;
    left: 1%;
  }

  .node-build {
    top: 18%;
    right: 0;
  }

  .node-connect {
    bottom: 17%;
    left: 0;
  }

  .node-manage {
    right: 1%;
    bottom: 14%;
  }

  .node-icon {
    display: grid;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    flex: 0 0 auto;
    place-items: center;
    color: #9cc2ff;
    background: rgba(80, 141, 230, 0.16);
  }

  .node-icon svg {
    width: 19px;
    height: 19px;
  }

  .node-copy {
    display: grid;
    gap: 1px;
  }

  .node-copy strong {
    color: #f2f7ff;
    font-family: var(--heading);
    font-size: 12px;
    line-height: 1.3;
  }

  .node-copy small {
    color: #8fa5bf;
    font-size: 9px;
  }

  .tech-node > i {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #6ea8ff;
    box-shadow: 0 0 10px #6ea8ff;
  }

  .tech-caption {
    position: absolute;
    bottom: 0;
    left: 50%;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #7f96b3;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .tech-caption span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #6ea8ff;
  }

  @media (max-width: 520px) {
    .tech-visual {
      max-width: 420px;
    }

    .tech-hub {
      width: 122px;
      height: 122px;
      border-radius: 30px;
    }

    .tech-hub img {
      width: 60px;
      height: 60px;
    }

    .tech-node {
      min-width: 132px;
      padding: 10px;
      gap: 8px;
    }

    .node-icon {
      width: 29px;
      height: 29px;
    }

    .node-copy strong {
      font-size: 10px;
    }

    .node-copy small {
      font-size: 8px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .tech-hub {
      animation: hub-float 7s ease-in-out infinite;
    }

    .tech-node {
      animation: node-float 8s ease-in-out infinite;
    }

    .node-build,
    .node-connect {
      animation-delay: -3s;
    }

    @keyframes hub-float {
      0%, 100% { transform: translate(-50%, -50%) rotate(-6deg) translateY(0); }
      50% { transform: translate(-50%, -50%) rotate(-4deg) translateY(-8px); }
    }

    @keyframes node-float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-5px); }
    }
  }
</style>
