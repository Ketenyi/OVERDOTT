---
import BrandLogo from './BrandLogo.astro';
import { findService, servicePillars } from '../data/services';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const popularServices = [
  'website-development',
  'software-development',
  'infrastructure',
  'cybersecurity',
].map(findService).filter((service) => service !== undefined);

const links = [
  { href: '/solutions/', label: 'Solutions' },
  { href: '/products/', label: 'Products' },
  { href: '/about/', label: 'About' },
  { href: '/insights/', label: 'Insights' },
];

const isActive = (href: string) => {
  const target = href.replace(/\/+$/, '');
  if (target === '/products') return path === '/products' || path.startsWith('/products/') || path === '/velldot' || path.startsWith('/velldot/');
  return path === target || path.startsWith(`${target}/`);
};

const servicesActive = path === '/services'
  || path.startsWith('/services/')
  || path === '/digital-services'
  || path.startsWith('/digital-services/');
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand-link" href="/" aria-label="Overdott Technologies Limited home">
      <BrandLogo variant="white" width={170} />
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      data-menu-button
    >
      <span class="sr-only">Toggle navigation</span>
      <span class="menu-lines" aria-hidden="true"></span>
    </button>

    <nav id="primary-navigation" class="primary-navigation" aria-label="Main navigation" data-navigation>
      <div class="nav-links">
        <details class="nav-dropdown" data-nav-dropdown data-active={servicesActive ? 'true' : undefined}>
          <summary class="nav-dropdown-trigger" aria-controls="services-menu" aria-current={servicesActive ? 'page' : undefined}>
            Services
            <svg class="nav-chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <div class="mega-menu" id="services-menu">
            <div class="mega-menu-inner page-width">
              <div class="mega-menu-heading">
                <p class="eyebrow">Technology. Built for Business.</p>
                <h2>Practical solutions, connected around your needs.</h2>
                <p>From your website to the systems behind it, we help businesses simplify operations, improve visibility and grow with confidence.</p>
                <a class="text-link" href="/services/">Explore all services <span aria-hidden="true">→</span></a>
              </div>

              <div class="mega-menu-columns">
                <div>
                  <p class="mega-menu-label">Primary service areas</p>
                  {servicePillars.map((pillar) => (
                    <a class="mega-menu-link" href={pillar.href}>
                      <strong>{pillar.title}</strong>
                      <span>{pillar.summary}</span>
                    </a>
                  ))}
                </div>
                <div>
                  <p class="mega-menu-label">Popular capabilities</p>
                  {popularServices.map((service) => service && (
                    <a class="mega-menu-link" href={`/services/${service.slug}/`}>
                      <strong>{service.title}</strong>
                      <span>{service.summary}</span>
                    </a>
                  ))}
                </div>
              </div>

              <a class="mega-menu-feature" href="/velldot/">
                <span class="mega-feature-mark"><img src="/velldot-mark.svg" alt="" width="34" height="34" /></span>
                <small>Product initiative by Overdott</small>
                <strong>Velldot business software</strong>
                <span>Explore ERP capabilities, product plans and deployment enquiries.</span>
                <b>Explore Velldot <span aria-hidden="true">↗</span></b>
              </a>
            </div>
          </div>
        </details>

        {links.map((link) => (
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>
        ))}
      </div>

      <a class="button button-small header-cta" href="/contact/">
        Let’s discuss <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>
