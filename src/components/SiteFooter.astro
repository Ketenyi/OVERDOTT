---
import BrandLogo from './BrandLogo.astro';
import { contactEmail, whatsappDisplay, whatsappNumber } from '../config';
---

<footer class="site-footer">
  <div class="footer-main page-width">
    <div class="footer-brand">
      <a class="brand-link" href="/" aria-label="Overdott Technologies Limited home">
        <BrandLogo variant="white" width={190} />
      </a>
      <p class="footer-statement">Technology, integrated.<br />Security, considered.</p>
      <p class="footer-note">Corporate websites, business software, technology sourcing and cybersecurity solutions for organizations in Kenya.</p>
      <div class="footer-contact">
        <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
        <a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer">
          WhatsApp {whatsappDisplay} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <div class="footer-links">
      <div>
        <h2>Solutions</h2>
        <a href="/services/infrastructure/">IT infrastructure</a>
        <a href="/services/cybersecurity/">Cybersecurity</a>
        <a href="/services/cloud-it-management/">Cloud &amp; IT management</a>
        <a href="/services/technology-procurement/">Technology sourcing</a>
      </div>
      <div>
        <h2>Digital</h2>
        <a href="/services/software-development/">Software development</a>
        <a href="/services/website-development/">Website development</a>
        <a href="/digital-services/">All digital services</a>
        <a href="/insights/">Insights</a>
      </div>
      <div>
        <h2>Products</h2>
        <a href="/velldot/">Velldot ERP</a>
        <a href="/products/">Software &amp; licensing</a>
        <a href="/products/#categories">Technology categories</a>
        <a href="/contact/">Contact Overdott</a>
      </div>
    </div>
  </div>
  <div class="footer-bottom page-width">
    <span>© {new Date().getFullYear()} Overdott Technologies Limited.</span>
    <a href="/privacy/">Privacy notice</a>
    <span>Built for clearer business.</span>
  </div>
</footer>
