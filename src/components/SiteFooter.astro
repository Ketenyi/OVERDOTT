---
import BrandLogo from './BrandLogo.astro';
import { contactEmail, whatsappDisplay, whatsappNumber } from '../config';
---

<footer class="site-footer">
  <div class="footer-main page-width">
    <div class="footer-brand">
      <a class="brand-link" href="/" aria-label="Overdott Technologies Limited home">
        <BrandLogo variant="white" width={190} />
      </a>
      <p class="footer-statement">Technology.<br />Built for Business.</p>
      <p class="footer-note">We design and deliver digital solutions that simplify business operations, connect people and processes, and make technology work for businesses.</p>
      <div class="footer-contact">
        <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
        <a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer">
          WhatsApp {whatsappDisplay} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <div class="footer-links">
      <div>
        <h2>Services</h2>
        <a href="/services/">All services</a>
        <a href="/digital-services/">Digital solutions &amp; development</a>
        <a href="/services/software-development/">Business systems &amp; automation</a>
        <a href="/services/infrastructure/">IT infrastructure &amp; technical services</a>
      </div>
      <div>
        <h2>Solutions</h2>
        <a href="/solutions/#digital-presence">Digital business presence</a>
        <a href="/solutions/#process-digitization">Business process digitization</a>
        <a href="/solutions/#inventory-management">Inventory &amp; operations</a>
        <a href="/solutions/#custom-applications">Custom applications</a>
        <a href="/solutions/#infrastructure-reliability">Infrastructure reliability</a>
      </div>
      <div>
        <h2>Explore</h2>
        <a href="/velldot/">Velldot business software</a>
        <a href="/products/">Products &amp; technology sourcing</a>
        <a href="/about/">About Overdott</a>
        <a href="/insights/">Insights</a>
        <a href="/contact/">Contact Overdott</a>
      </div>
    </div>
  </div>
  <div class="footer-bottom page-width">
    <span>© {new Date().getFullYear()} Overdott Technologies Limited.</span>
    <a href="/privacy/">Privacy notice</a>
    <span>Built for clearer business.</span>
  </div>
</footer>
